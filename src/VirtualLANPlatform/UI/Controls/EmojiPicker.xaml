<UserControl x:Class="VirtualLANPlatform.UI.Controls.EmojiPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             FlowDirection="LeftToRight">

    <Border Width="352" Height="392"
            Background="{StaticResource Elevated}"
            BorderBrush="{StaticResource Stroke}"
            BorderThickness="1"
            CornerRadius="14"
            Effect="{StaticResource SoftShadow}">
        <Grid Margin="6,8,6,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Category tabs -->
            <ItemsControl Grid.Row="0" x:Name="Tabs" Margin="4,0,4,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Height="32" Padding="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                Template="{StaticResource Tpl.Flat}"
                                ToolTip="{Binding Name}"
                                Tag="{Binding}"
                                Click="Tab_Click">
                            <Image Width="19" Height="19"
                                   emoji:Image.Source="{Binding Icon}"/>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Row="1" Height="1" Background="{StaticResource StrokeSoft}" Margin="2,0,2,4"/>

            <!-- Emoji grid, one ListBox row per visual row so it virtualizes -->
            <ListBox Grid.Row="2" x:Name="Rows"
                     Background="Transparent" BorderThickness="0"
                     Focusable="False"
                     ItemContainerStyle="{StaticResource BareItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="36" Height="36" Padding="0" Cursor="Hand"
                                            Background="Transparent" BorderThickness="0"
                                            Template="{StaticResource Tpl.Flat}"
                                            ToolTip="{Binding Name}"
                                            Tag="{Binding Text}"
                                            Click="Emoji_Click">
                                        <Image Width="25" Height="25"
                                               emoji:Image.Source="{Binding Text}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="3" x:Name="GroupLabel" Text=""
                       Foreground="{StaticResource TxtLo}" FontSize="11"
                       Margin="8,6,8,2"/>
        </Grid>
    </Border>
</UserControl>
