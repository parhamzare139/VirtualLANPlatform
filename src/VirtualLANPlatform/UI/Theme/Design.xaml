<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="clr-namespace:VirtualLANPlatform.UI">

    <!-- ═══════════════════════════════════════════════════════════════
         PALETTE
         Deep blue-black base, indigo→violet accent, semantic states.
    ═══════════════════════════════════════════════════════════════ -->

    <Color x:Key="C.Base">#0B0D12</Color>
    <Color x:Key="C.Surface">#131722</Color>
    <Color x:Key="C.Elevated">#1A1F2C</Color>
    <Color x:Key="C.Input">#0F1219</Color>
    <Color x:Key="C.Stroke">#252B3A</Color>
    <Color x:Key="C.StrokeSoft">#1C2130</Color>
    <Color x:Key="C.Accent">#6366F1</Color>
    <Color x:Key="C.Accent2">#8B5CF6</Color>
    <Color x:Key="C.AccentDim">#4F52D6</Color>
    <Color x:Key="C.Ok">#22C55E</Color>
    <Color x:Key="C.Warn">#F59E0B</Color>
    <Color x:Key="C.Danger">#EF4444</Color>
    <Color x:Key="C.TxtHi">#E8EAF0</Color>
    <Color x:Key="C.TxtMid">#98A0B3</Color>
    <Color x:Key="C.TxtLo">#5B6377</Color>

    <SolidColorBrush x:Key="Base"       Color="{StaticResource C.Base}"/>
    <SolidColorBrush x:Key="Surface"    Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="Elevated"   Color="{StaticResource C.Elevated}"/>
    <SolidColorBrush x:Key="InputBg"    Color="{StaticResource C.Input}"/>
    <SolidColorBrush x:Key="Stroke"     Color="{StaticResource C.Stroke}"/>
    <SolidColorBrush x:Key="StrokeSoft" Color="{StaticResource C.StrokeSoft}"/>
    <SolidColorBrush x:Key="Accent"     Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="Accent2"    Color="{StaticResource C.Accent2}"/>
    <SolidColorBrush x:Key="Ok"         Color="{StaticResource C.Ok}"/>
    <SolidColorBrush x:Key="Warn"       Color="{StaticResource C.Warn}"/>
    <SolidColorBrush x:Key="Danger"     Color="{StaticResource C.Danger}"/>
    <SolidColorBrush x:Key="TxtHi"      Color="{StaticResource C.TxtHi}"/>
    <SolidColorBrush x:Key="TxtMid"     Color="{StaticResource C.TxtMid}"/>
    <SolidColorBrush x:Key="TxtLo"      Color="{StaticResource C.TxtLo}"/>

    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource C.Accent}"  Offset="0"/>
        <GradientStop Color="{StaticResource C.Accent2}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="OkGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#22C55E" Offset="0"/>
        <GradientStop Color="#10B981" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="DangerGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F43F5E" Offset="0"/>
        <GradientStop Color="#DC2626" Offset="1"/>
    </LinearGradientBrush>

    <!-- Faint top-down sheen laid over cards so flat panels read as surfaces -->
    <LinearGradientBrush x:Key="CardGrad" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E2433" Offset="0"/>
        <GradientStop Color="#161B27" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGrad" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0A0C11" Offset="0"/>
        <GradientStop Color="#12131E" Offset="0.5"/>
        <GradientStop Color="#0A0C11" Offset="1"/>
    </LinearGradientBrush>

    <sys:Double x:Key="Radius">12</sys:Double>
    <CornerRadius x:Key="RadiusCard">14</CornerRadius>
    <CornerRadius x:Key="RadiusCtl">10</CornerRadius>

    <DropShadowEffect x:Key="SoftShadow" BlurRadius="24" ShadowDepth="4"
                      Direction="270" Opacity="0.45" Color="#000000"/>
    <DropShadowEffect x:Key="AccentGlow" BlurRadius="18" ShadowDepth="0"
                      Opacity="0.55" Color="#6366F1"/>

    <BooleanToVisibilityConverter x:Key="BoolVis"/>
    <ui:InitialConverter          x:Key="Initial"/>
    <ui:LinkFlowDocumentConverter x:Key="LinkTextConv"/>

    <!-- ═══════════════════════════════════════════════════════════════
         SCROLLBAR — thin, self-effacing, matches the surface
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" Background="#2E3548" CornerRadius="4" Margin="3,0"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#465073"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Height" Value="10"/>
                            <Setter Property="Width"  Value="Auto"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         BUTTON TEMPLATES
    ═══════════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="Tpl.Solid" TargetType="Button">
        <Border x:Name="Root"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="10"
                Padding="{TemplateBinding Padding}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform><ScaleTransform x:Name="Sc"/></Border.RenderTransform>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseDown">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.955" Duration="0:0:0.07"/>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.955" Duration="0:0:0.07"/>
                </Storyboard></BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseUp">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.28"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.45" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Background" Value="#171B26"/>
                <Setter TargetName="Root" Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="#3D4457"/>
                <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Circular icon-only control (voice strip, chat actions) -->
    <ControlTemplate x:Key="Tpl.IconRound" TargetType="Button">
        <Grid>
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="999"
                    Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform><ScaleTransform x:Name="Sc"/></Border.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.09" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.09" Duration="0:0:0.15"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
                </Storyboard></BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseDown">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.07"/>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.07"/>
                </Storyboard></BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="PreviewMouseUp">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.6" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                </Storyboard></BeginStoryboard>
            </EventTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Background" Value="#151925"/>
                <Setter Property="Foreground" Value="#3D4457"/>
                <Setter TargetName="Root" Property="Effect" Value="{x:Null}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Flat hover-tint template, no scale — for list rows and small affordances -->
    <ControlTemplate x:Key="Tpl.Flat" TargetType="Button">
        <Border x:Name="Root" CornerRadius="8" Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#222839"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Background" Value="#2C3348"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ═══════════════════════════════════════════════════════════════
         BUTTON STYLES
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="Btn.Primary" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource AccentGrad}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding"         Value="18,10"/>
        <Setter Property="FontSize"        Value="13"/>
        <Setter Property="FontWeight"      Value="SemiBold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template"        Value="{StaticResource Tpl.Solid}"/>
    </Style>

    <Style x:Key="Btn.Success" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Background" Value="{StaticResource OkGrad}"/>
    </Style>

    <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
        <Setter Property="Background" Value="{StaticResource DangerGrad}"/>
    </Style>

    <Style x:Key="Btn.Ghost" TargetType="Button">
        <Setter Property="Background"      Value="#1B2130"/>
        <Setter Property="Foreground"      Value="{StaticResource TxtMid}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource Stroke}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding"         Value="14,8"/>
        <Setter Property="FontSize"        Value="12.5"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template"        Value="{StaticResource Tpl.Solid}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="#242B3D"/>
                <Setter Property="Foreground"  Value="{StaticResource TxtHi}"/>
                <Setter Property="BorderBrush" Value="#39415A"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 40 px circular icon button; Background is set per instance -->
    <Style x:Key="Btn.Icon" TargetType="Button">
        <Setter Property="Background"      Value="#1B2130"/>
        <Setter Property="Foreground"      Value="{StaticResource TxtHi}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"           Value="40"/>
        <Setter Property="Height"          Value="40"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template"        Value="{StaticResource Tpl.IconRound}"/>
    </Style>

    <!-- Small square icon button for inline row actions -->
    <Style x:Key="Btn.IconSm" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource TxtLo}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Width"           Value="26"/>
        <Setter Property="Height"          Value="26"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template"        Value="{StaticResource Tpl.Flat}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource TxtHi}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Btn.Nav" TargetType="Button">
        <Setter Property="Background"               Value="Transparent"/>
        <Setter Property="Foreground"               Value="{StaticResource TxtMid}"/>
        <Setter Property="BorderThickness"          Value="0"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="Padding"                  Value="12,10"/>
        <Setter Property="HorizontalAlignment"      Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Right"/>
        <Setter Property="Cursor"                   Value="Hand"/>
        <Setter Property="Template"                 Value="{StaticResource Tpl.Flat}"/>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         INPUTS
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="Inp" TargetType="TextBox">
        <Setter Property="Background"                Value="{StaticResource InputBg}"/>
        <Setter Property="Foreground"                Value="{StaticResource TxtHi}"/>
        <Setter Property="CaretBrush"                Value="{StaticResource Accent}"/>
        <Setter Property="SelectionBrush"            Value="{StaticResource Accent}"/>
        <Setter Property="BorderBrush"               Value="{StaticResource Stroke}"/>
        <Setter Property="BorderThickness"           Value="1"/>
        <Setter Property="Padding"                   Value="12,0"/>
        <Setter Property="FontSize"                  Value="13"/>
        <Setter Property="VerticalContentAlignment"  Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"
                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="#39415A"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            <Setter TargetName="Root" Property="Background"  Value="#141926"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Cmb" TargetType="ComboBox">
        <Setter Property="Background"               Value="{StaticResource InputBg}"/>
        <Setter Property="Foreground"               Value="{StaticResource TxtHi}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource Stroke}"/>
        <Setter Property="BorderThickness"          Value="1"/>
        <Setter Property="FontSize"                 Value="12.5"/>
        <Setter Property="FontFamily"               Value="Consolas"/>
        <Setter Property="Cursor"                   Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{StaticResource TxtHi}"/>
                    <Setter Property="Padding"    Value="12,9"/>
                    <Setter Property="FontFamily" Value="Consolas"/>
                    <Setter Property="FontSize"   Value="12.5"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="B" Background="{TemplateBinding Background}"
                                        CornerRadius="7" Padding="{TemplateBinding Padding}" Margin="4,1">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="#2A3150"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0" Margin="12,0,0,0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0"
                                      Stroke="{StaticResource TxtLo}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ToggleButton Focusable="False" Opacity="0" BorderThickness="0"
                                      Background="Transparent"
                                      IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                               AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{TemplateBinding IsDropDownOpen}">
                            <Border Background="{StaticResource Elevated}"
                                    BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                    CornerRadius="10" Margin="0,6,0,0" Padding="0,4"
                                    Effect="{StaticResource SoftShadow}"
                                    MinWidth="{TemplateBinding ActualWidth}">
                                <ScrollViewer MaxHeight="220"><ItemsPresenter/></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="#39415A"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         SLIDER — used for the mic / speaker gain controls
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="VolSlider" TargetType="Slider">
        <Setter Property="Minimum"       Value="0"/>
        <Setter Property="Maximum"       Value="200"/>
        <Setter Property="Height"        Value="18"/>
        <Setter Property="IsMoveToPointEnabled" Value="True"/>
        <Setter Property="Cursor"        Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center" Background="Transparent">
                        <Border Height="5" CornerRadius="3" Background="#232939"
                                VerticalAlignment="Center"/>
                        <Border x:Name="Fill" Height="5" CornerRadius="3"
                                Background="{StaticResource AccentGrad}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" IsTabStop="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" IsTabStop="False"/>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Th">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Grid Width="15" Height="15">
                                                <Ellipse x:Name="Dot" Fill="White"
                                                         Effect="{StaticResource AccentGlow}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Dot" Property="Fill" Value="#EEF0FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════
         SURFACES & TEXT
    ═══════════════════════════════════════════════════════════════ -->

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource CardGrad}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource StrokeSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="14"/>
        <Setter Property="Padding"         Value="20"/>
    </Style>

    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource Surface}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource StrokeSoft}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius"    Value="14"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground"     Value="{StaticResource TxtLo}"/>
        <Setter Property="FontSize"       Value="10.5"/>
        <Setter Property="FontWeight"     Value="Bold"/>
    </Style>

    <Style x:Key="Lbl" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TxtLo}"/>
        <Setter Property="FontSize"   Value="11.5"/>
    </Style>

    <Style x:Key="Val" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TxtHi}"/>
        <Setter Property="FontSize"   Value="12"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>

    <!-- Chrome-free list container: the item template owns all visuals -->
    <Style x:Key="BareItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
