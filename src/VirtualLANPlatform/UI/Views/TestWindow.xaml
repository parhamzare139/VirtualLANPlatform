                        <Button Style="{StaticResource Btn.Ghost}"
                                Height="46" Padding="20,0" Click="UpnpClose_Click"
                                Content="{loc:Tr Common_NeverMind}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

