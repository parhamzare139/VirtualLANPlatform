        <!-- ══════════ UPnP HELP ══════════ -->
        <!--
          Shown when the pre-flight probe says hosting would not be reachable. The steps
          are built in code because they differ per diagnosis and name the user's own
          router and addresses — generic instructions are the reason people give up here.
        -->
        <Grid x:Name="UpnpHelp" Grid.RowSpan="3" Background="#F20A0C11"
              Visibility="Collapsed">
            <Border Background="{StaticResource Elevated}" CornerRadius="18"
                    BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
