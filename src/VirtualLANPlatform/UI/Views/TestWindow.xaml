<Window x:Class="VirtualLANPlatform.UI.Views.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VirtualLANPlatform.UI.Views"
        xmlns:chat="clr-namespace:VirtualLANPlatform.Core.Chat"
        Title="Virtual LAN Platform"
        Height="720" Width="1100"
        MinHeight="620" MinWidth="920"
        FlowDirection="RightToLeft"
        Background="#1A1D23"
        FontFamily="Inter, Vazir"
        Opacity="0"
        Closing="Window_Closing">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>

        <!-- ══════════════════════════════════════════
             SHARED ANIMATED BUTTON TEMPLATES
        ══════════════════════════════════════════ -->

        <!-- Standard rounded button (used by Btn, GhostBtn) -->
        <ControlTemplate x:Key="AnimBtn" TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <!-- Hover: subtle brightness lift -->
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.12"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15"/>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
                <!-- Press: scale down -->
                <EventTrigger RoutedEvent="PreviewMouseDown">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.08"/>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.08"/>
                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.05"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
                <!-- Release: spring back -->
                <EventTrigger RoutedEvent="PreviewMouseUp">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.3" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Pill button for voice/media controls -->
        <ControlTemplate x:Key="AnimPillBtn" TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    CornerRadius="18"
                    Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <!-- Hover: lift scale -->
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.06" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.06" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Root"  Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.1"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="PreviewMouseDown">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.93" Duration="0:0:0.08"/>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.93" Duration="0:0:0.08"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="PreviewMouseUp">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.3"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.5" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.18"/>
                        <DoubleAnimation Storyboard.TargetName="Root"  Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Root" Property="Background" Value="#1E2025"/>
                    <Setter Property="Foreground" Value="#3A3D44"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Tab underline button -->
        <ControlTemplate x:Key="AnimTabBtn" TargetType="Button">
            <Border x:Name="Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,1">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="PreviewMouseDown">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.92" Duration="0:0:0.07"/>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.92" Duration="0:0:0.07"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="PreviewMouseUp">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase Amplitude="0.35" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard><Storyboard>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                        <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ══════════════════════════════════════════
             BUTTON STYLES
        ══════════════════════════════════════════ -->

        <!-- Primary blue button -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background"      Value="#4361EE"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template"        Value="{StaticResource AnimBtn}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3650D8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2D35"/>
                    <Setter Property="Foreground" Value="#4E5058"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Red danger button (inherits Btn template + animation) -->
        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#ED4245"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C03537"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#2A2D35"/>
                    <Setter Property="Foreground" Value="#4E5058"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Ghost/secondary button -->
        <Style x:Key="GhostBtn" TargetType="Button">
            <Setter Property="Background"      Value="#2E3035"/>
            <Setter Property="Foreground"      Value="#B5BAC1"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template"        Value="{StaticResource AnimBtn}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3A3D44"/>
                    <Setter Property="Foreground" Value="#DBDEE1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#1E2025"/>
                    <Setter Property="Foreground" Value="#3A3D44"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Voice/media pill button -->
        <Style x:Key="VoiceBtn" TargetType="Button">
            <Setter Property="Background"      Value="#248046"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="FontWeight"      Value="Medium"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template"        Value="{StaticResource AnimPillBtn}"/>
        </Style>

        <!-- Tab underline button -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="#80848E"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="Padding"         Value="4,0,4,6"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontFamily"      Value="Vazir"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template"        Value="{StaticResource AnimTabBtn}"/>
        </Style>

        <!-- Left nav sidebar: hover-bg template -->
        <ControlTemplate x:Key="NavItemTpl" TargetType="Button">
            <Border CornerRadius="8" Padding="{TemplateBinding Padding}">
                <Border.Background>
                    <SolidColorBrush x:Name="BgBrush" Color="Transparent"/>
                </Border.Background>
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard><Storyboard>
                        <ColorAnimation Storyboard.TargetName="BgBrush"
                                        Storyboard.TargetProperty="Color"
                                        To="#2C2F36" Duration="0:0:0.12"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard><Storyboard>
                        <ColorAnimation Storyboard.TargetName="BgBrush"
                                        Storyboard.TargetProperty="Color"
                                        To="Transparent" Duration="0:0:0.15"/>
                    </Storyboard></BeginStoryboard>
                </EventTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background"          Value="Transparent"/>
            <Setter Property="Foreground"          Value="#80848E"/>
            <Setter Property="BorderThickness"     Value="0"/>
            <Setter Property="FontFamily"          Value="Vazir"/>
            <Setter Property="FontSize"            Value="13"/>
            <Setter Property="Padding"             Value="14,11"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor"              Value="Hand"/>
            <Setter Property="Template"            Value="{StaticResource NavItemTpl}"/>
        </Style>

        <!-- ══════════════════════════════════════════
             TEXT BOX WITH ROUNDED CORNERS
        ══════════════════════════════════════════ -->
        <Style x:Key="Inp" TargetType="TextBox">
            <Setter Property="Background"             Value="#1E2025"/>
            <Setter Property="Foreground"             Value="#DBDEE1"/>
            <Setter Property="CaretBrush"             Value="#DBDEE1"/>
            <Setter Property="SelectionBrush"         Value="#4361EE"/>
            <Setter Property="BorderBrush"            Value="#3A3D44"/>
            <Setter Property="BorderThickness"        Value="1"/>
            <Setter Property="Padding"                Value="10,0"/>
            <Setter Property="FontSize"               Value="13"/>
            <Setter Property="FontFamily"             Value="Vazir"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4361EE"/>
                                <Setter TargetName="Root" Property="Background"  Value="#22252C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════════════════════════════════════
             PANEL STYLES
        ══════════════════════════════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"   Value="#23262D"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding"      Value="18"/>
        </Style>

        <Style x:Key="SideCard" TargetType="Border">
            <Setter Property="Background"   Value="#1E2025"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding"      Value="12"/>
        </Style>

        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#80848E"/>
            <Setter Property="FontSize"   Value="11"/>
        </Style>

        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#DBDEE1"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>

        <!-- ══════════════════════════════════════════
             DATA TEMPLATES
        ══════════════════════════════════════════ -->

        <!-- Chat message bubble -->
        <DataTemplate DataType="{x:Type chat:ChatMessage}">
            <Border Padding="0,5" Opacity="0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,10,0,0" To="0,0,0,0" Duration="0:0:0.28"><ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction></ThicknessAnimation>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Sender}"
                                   Foreground="#4361EE" FontWeight="Bold"
                                   FontSize="12" Margin="0,0,8,2" FontFamily="Vazir"/>
                        <TextBlock Text="{Binding SentAt, StringFormat='HH:mm'}"
                                   Foreground="#4E5058" FontSize="10"
                                   FontFamily="Inter"
                                   VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Text}"
                               Foreground="#DBDEE1" FontSize="13"
                               FontFamily="Vazir"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Incoming/outgoing file card -->
        <DataTemplate DataType="{x:Type local:FileNotification}">
            <Border Background="#2A2D35" CornerRadius="8"
                    Padding="12,9" Margin="0,3" Opacity="0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,12,0,-9" To="0,3,0,3" Duration="0:0:0.3"><ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction></ThicknessAnimation>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="#4361EE" CornerRadius="8"
                            Width="38" Height="38" Margin="0,0,10,0">
                        <TextBlock Text="📎" FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}"
                                   Foreground="#DBDEE1" FontWeight="SemiBold"
                                   FontSize="13" FontFamily="Vazir"
                                   TextWrapping="NoWrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SizeText}"
                                       Foreground="#80848E" FontSize="11" FontFamily="Inter"/>
                            <TextBlock Text="  ·  " Foreground="#4E5058" FontSize="11"/>
                            <TextBlock Text="{Binding Status}"
                                       Foreground="#80848E" FontSize="11" FontFamily="Vazir"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="⬇ دانلود"
                            IsEnabled="{Binding CanDownload}"
                            Visibility="{Binding DownloadVisibility}"
                            Style="{StaticResource Btn}"
                            Background="#248046"
                            Padding="10,5" FontSize="12"
                            Margin="12,0,0,0"
                            Click="DownloadFile_Click"/>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             TOP BAR
        ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="#111214">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Logo mark -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            FlowDirection="LeftToRight">
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           Width="26" Height="26" Margin="0,0,8,0"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="VirtualLAN" Foreground="White"
                               FontSize="15" FontWeight="Bold"
                               FontFamily="Inter"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Status indicator — spans all columns so it's truly centered in the bar -->
                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            FlowDirection="RightToLeft" IsHitTestVisible="False">
                    <Ellipse x:Name="StatusEllipse"
                             Width="10" Height="10" Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1"/>
                        </Ellipse.RenderTransform>
                        <Ellipse.Fill>
                            <SolidColorBrush x:Name="StatusDot" Color="#747F8D"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock x:Name="StatusLabel" Text="آماده"
                               Foreground="#DBDEE1" FontSize="13"
                               FontFamily="Vazir"/>
                </StackPanel>

                <!-- Lobby: only cancel button (username moved to sidebar) -->
                <StackPanel x:Name="LobbyHeaderPanel" Grid.Column="2"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelOpBtn" Content="لغو عملیات"
                            Style="{StaticResource DangerBtn}"
                            FontFamily="Vazir"
                            Height="34" Padding="12,0"
                            Visibility="Collapsed"
                            Click="CancelOp_Click"/>
                </StackPanel>

                <!-- Room header: just the leave button -->
                <StackPanel x:Name="RoomHeaderPanel" Grid.Column="2"
                            Orientation="Horizontal" Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <Button x:Name="LeaveCloseBtn" Content="خروج از Room"
                            Style="{StaticResource DangerBtn}"
                            FontFamily="Vazir"
                            IsEnabled="False" Padding="12,6" FontSize="12"
                            Click="LeaveClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             MAIN CONTENT
        ══════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="16,14,16,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="165"/>
            </Grid.ColumnDefinitions>

            <!-- ── PROFILE SIDEBAR (left in RTL = Col 4) ──── -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Username card — hidden in room -->
                <Border x:Name="UsernameSection" Grid.Row="0"
                        Background="#1E2025" CornerRadius="10" Padding="12,16,12,14">
                    <StackPanel>
                        <TextBox x:Name="UsernameBox" Text="کاربر"
                                 Style="{StaticResource Inp}" Height="34"/>
                        <Button x:Name="SaveUsernameBtn" Content="ذخیره"
                                Style="{StaticResource GhostBtn}"
                                FontFamily="Vazir"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Stretch"
                                Height="32" Padding="0"
                                Click="SaveUsername_Click"/>
                    </StackPanel>
                </Border>

                <!-- Donate at bottom -->
                <Border Grid.Row="2" BorderBrush="#2C2F36" BorderThickness="0,1,0,0"
                        Padding="0,4,0,4">
                    <Button Style="{StaticResource NavBtn}"
                            Foreground="#ED4245"
                            Margin="8,0"
                            Click="NavDonate_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="❤" Margin="0,0,7,0" FontSize="13"/>
                            <TextBlock Text="حمایت از پروژه" FontFamily="Vazir" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </Border>
            </Grid>

            <!-- ── CENTER PANEL ─ Col 2 ──── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- VoiceStrip -->
                    <RowDefinition Height="*"/>     <!-- Lobby / Chat (shared) -->
                </Grid.RowDefinitions>

                <!-- Voice + File strip — hidden in lobby -->
                <Border Grid.Row="0" x:Name="VoiceStrip" Visibility="Collapsed"
                        Background="#23262D" CornerRadius="10" Padding="14,10"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎙" FontSize="15" Margin="0,0,7,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="صدا و فایل"
                                       Foreground="#DBDEE1" FontSize="12.5"
                                       FontFamily="Vazir"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="VoiceStatus" Text="—"
                                   Foreground="#4E5058" FontSize="11"
                                   FontFamily="Vazir"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="MicBtn"
                                    Content="🎤  میکروفون"
                                    Style="{StaticResource VoiceBtn}"
                                    Background="#248046"
                                    IsEnabled="False" Margin="0,0,7,0"
                                    Click="Mic_Click"/>
                            <Button x:Name="SpeakerBtn"
                                    Content="🔊  اسپیکر"
                                    Style="{StaticResource VoiceBtn}"
                                    Background="#248046"
                                    IsEnabled="False" Margin="0,0,7,0"
                                    Click="Speaker_Click"/>
                            <Button x:Name="SendFileBtn"
                                    Content="📎  ارسال فایل"
                                    Style="{StaticResource VoiceBtn}"
                                    Background="#2E3035"
                                    IsEnabled="False" Margin="0,0,7,0"
                                    Click="SendFile_Click"/>
                            <Button x:Name="ScreenShareBtn"
                                    Content="🖥  اشتراک صفحه"
                                    Style="{StaticResource VoiceBtn}"
                                    Background="#2E3035"
                                    IsEnabled="False"
                                    Click="ScreenShare_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Lobby action cards — auto height, full width, centered vertically -->
                <Grid x:Name="LobbyActions" Grid.Row="1" VerticalAlignment="Top">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="LobbySlide" Y="30"/>
                    </Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Grid.Loaded">
                            <BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LobbySlide"
                                                 Storyboard.TargetProperty="Y"
                                                 From="30" To="0" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.35"/>
                            </Storyboard></BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Two main cards (auto height, stretch width) -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Create Room card -->
                        <Border Grid.Column="0" Style="{StaticResource Card}"
                                x:Name="CreateCard" RenderTransformOrigin="0.5,0.5" Cursor="Arrow">
                            <Border.RenderTransform><ScaleTransform x:Name="CreateCardSc"/></Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CreateCardSc" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="CreateCardSc" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CreateCardSc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="CreateCardSc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"/>
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Background="#4361EE" CornerRadius="10"
                                            Width="42" Height="42" Margin="0,0,13,0">
                                        <TextBlock Text="🏠" FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ایجاد Room"
                                                   Foreground="White" FontSize="14"
                                                   FontFamily="Vazir" FontWeight="Bold"/>
                                        <TextBlock Text="نقش: هاست"
                                                   Foreground="#80848E" FontSize="11"
                                                   FontFamily="Vazir" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="یک Room بسازید. IP خود را با مهمانان به اشتراک بگذارید."
                                           Foreground="#80848E" FontSize="12.5"
                                           FontFamily="Vazir" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <Button x:Name="CreateBtn" Content="ساخت Room"
                                        Style="{StaticResource Btn}"
                                        FontFamily="Vazir"
                                        HorizontalAlignment="Stretch"
                                        Padding="0,11"
                                        Click="CreateRoom_Click"/>
                            </StackPanel>
                        </Border>

                        <!-- Join Room card -->
                        <Border Grid.Column="2" Style="{StaticResource Card}"
                                x:Name="JoinCard" RenderTransformOrigin="0.5,0.5" Cursor="Arrow">
                            <Border.RenderTransform><ScaleTransform x:Name="JoinCardSc"/></Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="JoinCardSc" Storyboard.TargetProperty="ScaleX" To="1.018" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="JoinCardSc" Storyboard.TargetProperty="ScaleY" To="1.018" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard><Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="JoinCardSc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.22"/>
                                        <DoubleAnimation Storyboard.TargetName="JoinCardSc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.22"/>
                                    </Storyboard></BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <Border Background="#248046" CornerRadius="10"
                                            Width="42" Height="42" Margin="0,0,13,0">
                                        <TextBlock Text="🔗" FontSize="20"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="اتصال به Room"
                                                   Foreground="White" FontSize="14"
                                                   FontFamily="Vazir" FontWeight="Bold"/>
                                        <TextBlock Text="نقش: مهمان"
                                                   Foreground="#80848E" FontSize="11"
                                                   FontFamily="Vazir" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Foreground="#80848E" FontSize="12.5"
                                           FontFamily="Vazir" TextWrapping="Wrap" Margin="0,0,0,12">
                                    <Run>IP هاست را وارد کنید (مثال: </Run>
                                    <Run FontFamily="Consolas" FlowDirection="LeftToRight">10.88.***.** </Run>
                                    <Run>)</Run>
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="JoinCodeBox"
                                             Style="{StaticResource Inp}"
                                             FlowDirection="LeftToRight"
                                             FontFamily="Consolas" FontSize="13"
                                             Height="38"/>
                                    <Button Grid.Column="2" x:Name="JoinBtn"
                                            Content="اتصال"
                                            FontFamily="Vazir"
                                            Padding="16,0" Height="38"
                                            Click="Join_Click">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                                                <Setter Property="Background" Value="#248046"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1a6335"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter Property="Background" Value="#2A2D35"/>
                                                        <Setter Property="Foreground" Value="#4E5058"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Settings card -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="PortBox" Text="42777"
                                     Style="{StaticResource Inp}"
                                     FlowDirection="LeftToRight"
                                     FontFamily="Consolas" FontSize="14"
                                     Width="80" Height="30" Padding="8,0"
                                     LostFocus="PortBox_LostFocus"
                                     KeyDown="PortBox_KeyDown"/>
                            <TextBlock Grid.Column="1" Text="پورت اتصال"
                                       Foreground="#80848E" FontSize="12"
                                       FontFamily="Vazir" VerticalAlignment="Center"
                                       Margin="0,0,60,0"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Chat panel — hidden in lobby, fills Row 1 when in room -->
                <Border Grid.Row="1" x:Name="ChatPanel"
                        Background="#23262D" CornerRadius="10" Padding="0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ListBox Grid.Row="0" x:Name="ChatList"
                                 Background="Transparent" BorderThickness="0"
                                 Padding="12,6"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding"    Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <Border Grid.Row="0" x:Name="ScreenSharePanel"
                                Background="#000000" Visibility="Collapsed">
                            <Grid>
                                <Image x:Name="ScreenFrameImage"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                <Border VerticalAlignment="Top"
                                        Background="#CC111214" Padding="12,5"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                FlowDirection="RightToLeft">
                                        <Ellipse Width="7" Height="7" Fill="#ED4245" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="ScreenSharerLabel"
                                                   Text="در حال دریافت صفحه..."
                                                   Foreground="#DBDEE1" FontSize="12"
                                                   FontFamily="Vazir"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" x:Name="ChatInputArea"
                              Margin="10,0,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ChatInput"
                                     Style="{StaticResource Inp}"
                                     Height="38"
                                     KeyDown="ChatInput_KeyDown"/>
                            <Button Grid.Column="2" Content="ارسال"
                                    Style="{StaticResource Btn}"
                                    FontFamily="Vazir"
                                    Padding="14,0" Height="38"
                                    Click="SendChat_Click"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── RIGHT SIDEBAR (right in RTL = Col 0) ──── -->
            <Grid Grid.Column="0" x:Name="RightSidebar" Visibility="Collapsed" Width="200" Margin="0,0,14,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Members list -->
                <Border Grid.Row="0" Style="{StaticResource SideCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="اعضای Room"
                                   Foreground="#80848E" FontSize="11"
                                   FontFamily="Vazir"
                                   FontWeight="Bold" Margin="0,0,0,10"
                                   TextAlignment="Right"/>

                        <ListBox Grid.Row="1" x:Name="MemberList"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background"  Value="Transparent"/>
                                    <Setter Property="Padding"     Value="0,4"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Opacity="0">
                                        <StackPanel.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard><Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                                                    <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,0,-12,0" To="0,0,0,0" Duration="0:0:0.3"><ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction></ThicknessAnimation>
                                                </Storyboard></BeginStoryboard>
                                            </EventTrigger>
                                        </StackPanel.Triggers>
                                        <Ellipse Width="8" Height="8"
                                                 Fill="#23A55A" Margin="0,0,9,0"/>
                                        <TextBlock Text="{Binding}"
                                                   Foreground="#DBDEE1" FontSize="13"
                                                   FontFamily="Vazir"
                                                   FlowDirection="LeftToRight"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Connection status -->
                <Border Grid.Row="2" Style="{StaticResource SideCard}">
                    <StackPanel>
                        <TextBlock Text="وضعیت اتصال"
                                   Foreground="#80848E" FontSize="11"
                                   FontFamily="Vazir"
                                   FontWeight="Bold" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="نقش" Style="{StaticResource Lbl}" FontFamily="Vazir"/>
                            <TextBlock x:Name="DbgRole" Grid.Column="1" Text="—"
                                       Style="{StaticResource Val}" FontFamily="Vazir"
                                       FlowDirection="LeftToRight"/>
                        </Grid>

                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="تعداد Peer" Style="{StaticResource Lbl}" FontFamily="Vazir"/>
                            <TextBlock x:Name="DbgPeers" Grid.Column="1" Text="0"
                                       Style="{StaticResource Val}" FontFamily="Inter"/>
                        </Grid>

                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="رمزنگاری" Style="{StaticResource Lbl}" FontFamily="Vazir"/>
                            <TextBlock x:Name="DbgEncryption" Grid.Column="1"
                                       Text="🔓" FontSize="12"
                                       Foreground="#FAA61A" FontFamily="Inter"
                                       FlowDirection="LeftToRight"/>
                        </Grid>

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ══════════════════════════════════════════
             FOOTER (hidden in room mode)
        ══════════════════════════════════════════ -->
        <Border x:Name="Footer" Grid.Row="2" Padding="16,6">
            <Grid>
                <TextBlock Text="Virtual LAN Platform  v1.0.0"
                           Foreground="#2E3035" FontSize="11"
                           FontFamily="Inter"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                <Button Content="بررسی بروزرسانی"
                        FontFamily="Vazir" FontSize="10"
                        Foreground="#4E5058" Background="Transparent"
                        BorderThickness="0" Cursor="Hand"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Click="CheckUpdate_Click"/>
            </Grid>
        </Border>

    </Grid>
</Window>
