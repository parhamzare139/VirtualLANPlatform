<Window x:Class="VirtualLANPlatform.UI.Views.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VirtualLANPlatform.UI.Views"
        xmlns:ui="clr-namespace:VirtualLANPlatform.UI"
        xmlns:chat="clr-namespace:VirtualLANPlatform.Core.Chat"
        xmlns:ctl="clr-namespace:VirtualLANPlatform.UI.Controls"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:loc="clr-namespace:VirtualLANPlatform.UI.Localization"
        Title="Virtual LAN Platform"
        Height="760" Width="1180"
        MinHeight="640" MinWidth="980"
        FlowDirection="{Binding Flow, Source={x:Static loc:Loc.I}}"
        Background="{StaticResource Base}"
        FontFamily="{Binding Font, Source={x:Static loc:Loc.I}}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Opacity="0"
        Closing="Window_Closing">

<!--
      The open fade lives in code-behind (FadeInWindow), not in a Storyboard here.
      A Storyboard on Window.Opacity keeps its clock attached for the lifetime of
      the window, which pins the HWND to the layered-window path and silently
      disables ClearType for *everything* inside it. Text looked soft everywhere
      because of this. The code-behind version detaches the animation on Completed.
    -->

    <Window.Resources>

        <!--
          Emoji.Wpf.TextBox is a shell whose template hosts an inner
          Emoji.Wpf.RichTextBox; properties set on the shell don't reach it.
          This implicit style is how the composer gets its dark treatment.
        -->
        <Style TargetType="{x:Type emoji:RichTextBox}">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Padding"                  Value="0"/>
            <Setter Property="Foreground"               Value="{StaticResource TxtHi}"/>
            <Setter Property="CaretBrush"               Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush"           Value="{StaticResource Accent}"/>
            <Setter Property="FontSize"                 Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Hidden"/>
            <Style.Resources>
                <Style TargetType="Paragraph"><Setter Property="Margin" Value="0"/></Style>
            </Style.Resources>
        </Style>

        <!-- Tab button styles (used inside ChatPanel) -->
        <ControlTemplate x:Key="Tpl.Tab" TargetType="Button">
            <Border x:Name="Root" Background="Transparent"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#0D1219"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="Tab.Btn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtLo}"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template"        Value="{StaticResource Tpl.Tab}"/>
        </Style>
        <Style x:Key="Tab.Active" TargetType="Button" BasedOn="{StaticResource Tab.Btn}">
            <Setter Property="Foreground"  Value="{StaticResource TxtHi}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>

        <!-- ══════════ CHAT MESSAGE ══════════ -->
        <!--
          Messenger layout: bubbles hug their text and take a side — own on the right,
          everyone else on the left.

          Wrapper is pinned to LeftToRight so "Left"/"Right" and Grid.Column mean the
          physical screen sides, full stop; under the window's inherited RTL they don't
          resolve the way you'd read them. The pieces that hold content — the bubble's
          inner stack and the action row — are switched back to RightToLeft so Persian
          text and icon order stay correct.
        -->
        <DataTemplate DataType="{x:Type chat:ChatMessage}">
            <Grid x:Name="Wrapper" Margin="6,2" Opacity="0"
                  FlowDirection="LeftToRight"
                  RenderTransformOrigin="0.5,0.5">
                <!-- Rise animated on a transform, not on Margin: a held Margin animation
                     outranks the ShowHeader setter below and would pin the spacing. -->
                <Grid.RenderTransform><TranslateTransform x:Name="Rise" Y="7"/></Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.24"/>
                            <DoubleAnimation Storyboard.TargetName="Rise" Storyboard.TargetProperty="Y"
                                             To="0" Duration="0:0:0.24">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.12"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>

                <!-- Column 0 is the physical LEFT slot. Incoming sits on the left with its
                     actions to the right of it (inboard); the IsOwn trigger swaps both. -->
                <Grid x:Name="Row" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- The bubble -->
                    <Border x:Name="Root" Grid.Column="0"
                            Background="#212A3E" CornerRadius="4,16,16,16"
                            Padding="12,8,12,7" MaxWidth="520">
                        <StackPanel FlowDirection="{Binding Flow, Source={x:Static loc:Loc.I}}">

                            <!-- Sender — first message of a run only, coloured like a messenger -->
                            <TextBlock x:Name="SenderName" Text="{Binding Sender}"
                                       FontSize="12.5" FontWeight="Bold"
                                       Foreground="{StaticResource Accent2}"
                                       Margin="0,0,0,3"/>

                            <!-- Quoted message -->
                            <Border Visibility="{Binding ReplyVisibility}"
                                    Background="#00000033" CornerRadius="6"
                                    BorderBrush="{StaticResource Accent2}" BorderThickness="0,0,3,0"
                                    Padding="8,4" Margin="0,1,0,5"
                                    Tag="{Binding ReplyToId}" Cursor="Hand"
                                    MouseLeftButtonUp="ReplyQuote_Click">
                                <StackPanel>
                                    <TextBlock Text="{Binding ReplyToSender}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent2}"/>
                                    <TextBlock Text="{Binding ReplyToText}" FontSize="11.5"
                                               Foreground="{StaticResource TxtMid}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Body + timestamp. The time sits on the last line's trailing edge
                                 when it fits, and drops below when the text is too wide. -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="Body" Grid.Column="0"
                                           ui:TextBlockHelper.InlineSource="{Binding Text, Mode=OneWay}"
                                           Foreground="{StaticResource TxtHi}" FontSize="13.5"
                                           TextWrapping="Wrap" LineHeight="20"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Bottom" Margin="10,0,0,-1">
                                    <TextBlock Text="{Binding SentAt, StringFormat='HH:mm'}"
                                               Foreground="#8C93A6" FontSize="10.5"
                                               FontFamily="Consolas" FlowDirection="LeftToRight"/>
                                    <ico:PackIconLucide x:Name="SentTick" Kind="Check"
                                                        Width="12" Height="12" Margin="3,0,0,0"
                                                        Foreground="#8C93A6" VerticalAlignment="Center"
                                                        Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Hover actions, floating beside the bubble -->
                    <StackPanel x:Name="Actions" Grid.Column="1" Orientation="Horizontal" Opacity="0"
                                FlowDirection="{Binding Flow, Source={x:Static loc:Loc.I}}"
                                VerticalAlignment="Center" Margin="4,0,4,0">
                        <Button Style="{StaticResource Btn.IconSm}" Width="26" Height="26" ToolTip="{loc:Tr Msg_Reply}"
                                Click="ReplyTo_Click"
                                Visibility="{Binding IsAlive, Converter={StaticResource BoolVis}}">
                            <ico:PackIconLucide Kind="Reply" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource Btn.IconSm}" Width="26" Height="26" ToolTip="{loc:Tr Msg_CopyText}"
                                Click="CopyMsg_Click"
                                Visibility="{Binding IsAlive, Converter={StaticResource BoolVis}}">
                            <ico:PackIconLucide Kind="Copy" Width="13" Height="13"/>
                        </Button>
                        <Button Style="{StaticResource Btn.IconSm}" Width="26" Height="26" ToolTip="{loc:Tr Msg_Delete}"
                                Click="DeleteMsg_Click"
                                Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}">
                            <ico:PackIconLucide Kind="Trash2" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                    <Setter TargetName="Body" Property="Foreground" Value="{StaticResource TxtLo}"/>
                    <Setter TargetName="Body" Property="FontStyle"  Value="Italic"/>
                    <Setter TargetName="Body" Property="FontSize"   Value="12.5"/>
                </DataTrigger>

                <!-- Own message: physical right, accent bubble, mirrored tail, delivery tick.
                     Swapping Grid.Column keeps the actions on the bubble's inboard flank. -->
                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                    <Setter TargetName="Row"        Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="Root"       Property="Grid.Column"  Value="1"/>
                    <Setter TargetName="Actions"    Property="Grid.Column"  Value="0"/>
                    <Setter TargetName="Root"       Property="Background"   Value="#2F4A87"/>
                    <Setter TargetName="Root"       Property="CornerRadius" Value="16,4,16,16"/>
                    <Setter TargetName="SenderName" Property="Visibility"   Value="Collapsed"/>
                    <Setter TargetName="SentTick"   Property="Visibility"   Value="Visible"/>
                </DataTrigger>

                <!-- Follow-up message in a run: no name, softened tail, tighter spacing -->
                <DataTrigger Binding="{Binding ShowHeader}" Value="False">
                    <Setter TargetName="SenderName" Property="Visibility"   Value="Collapsed"/>
                    <Setter TargetName="Root"       Property="CornerRadius" Value="16"/>
                    <Setter TargetName="Wrapper"    Property="Margin"       Value="6,0,6,2"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ══════════ FILE CARD ══════════ -->
        <DataTemplate DataType="{x:Type local:FileNotification}">
            <!-- Sized and sided like a chat bubble so files sit in the same conversation
                 rhythm. LeftToRight pins the side to physical screen coordinates; the
                 inner grid goes back to RightToLeft for the Persian content. -->
            <Border x:Name="FileRoot" Background="#212A3E" CornerRadius="4,16,16,16"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    Padding="12,10" Margin="8,4" Opacity="0"
                    FlowDirection="LeftToRight"
                    HorizontalAlignment="Left" MinWidth="300" MaxWidth="460">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="FileActions" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.12"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="FileActions" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                <!-- Pictures show themselves: a thumbnail above the usual file row, once the
                     bytes are on this machine (immediately for the sender). Click opens it. -->
                <Border Visibility="{Binding PreviewVisibility}" CornerRadius="10" Margin="0,0,0,10"
                        Background="#0E121C" Padding="4" HorizontalAlignment="Left" Cursor="Hand"
                        MouseLeftButtonUp="FilePreview_Click" ToolTip="{loc:Tr File_OpenTip}">
                    <Image Source="{Binding Preview}" Stretch="Uniform" MaxHeight="240" MaxWidth="420"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <Grid FlowDirection="{Binding Flow, Source={x:Static loc:Loc.I}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11"
                            Background="{StaticResource AccentGrad}" Margin="0,0,12,0">
                        <ico:PackIconLucide Kind="{Binding Icon}" Width="19" Height="19"
                                            Foreground="White"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TxtHi}"
                                   FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource TxtLo}"
                                       FontSize="11" FontFamily="Consolas" FlowDirection="LeftToRight"/>
                            <TextBlock Text="  ·  " Foreground="{StaticResource TxtLo}" FontSize="11"/>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TxtMid}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="FileActions" Orientation="Horizontal" Opacity="0" Margin="0,0,6,0">
                            <Button Style="{StaticResource Btn.IconSm}" ToolTip="{loc:Tr Msg_Reply}"
                                    Click="ReplyToFile_Click">
                                <ico:PackIconLucide Kind="Reply" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource Btn.Success}"
                                IsEnabled="{Binding CanDownload}"
                                Visibility="{Binding DownloadVisibility}"
                                Height="34" MinHeight="34" Padding="14,0" FontSize="12.5" Margin="6,0,0,0"
                                Click="DownloadFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <ico:PackIconLucide Kind="Download" Width="14" Height="14"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Tr File_Download}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
                </StackPanel>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSent}" Value="True">
                    <Setter TargetName="FileRoot" Property="HorizontalAlignment" Value="Right"/>
                    <Setter TargetName="FileRoot" Property="Background"          Value="#2F4A87"/>
                    <Setter TargetName="FileRoot" Property="CornerRadius"        Value="16,4,16,16"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ══════════ MEMBER ROW ══════════ -->
        <DataTemplate DataType="{x:Type local:MemberItem}">
            <Border x:Name="MRoot" Background="Transparent" CornerRadius="9"
                    Padding="7,6" Margin="0,1" Opacity="0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Mod" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.12"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Mod" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Presence: green online, violet in a game, amber away -->
                    <Ellipse Grid.Column="0" Width="8" Height="8" Margin="1,0,9,0"
                             VerticalAlignment="Center" Fill="{Binding StatusBrush}"
                             ToolTip="{Binding StatusLabel}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username}" Foreground="{StaticResource TxtHi}"
                                   FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding RoleLabel}" Foreground="{StaticResource TxtLo}"
                                   FontSize="10" Visibility="{Binding RoleVisibility}"/>
                    </StackPanel>

                    <StackPanel x:Name="Mod" Grid.Column="2" Orientation="Horizontal"
                                Opacity="0" Visibility="{Binding ModVisibility}">
                        <Button Style="{StaticResource Btn.IconSm}" Width="24" Height="24"
                                ToolTip="{Binding MuteTip}" Tag="{Binding}" Click="ModMute_Click">
                            <ico:PackIconLucide Kind="{Binding MuteIcon}" Width="13" Height="13"/>
                        </Button>
                        <Button Style="{StaticResource Btn.IconSm}" Width="24" Height="24"
                                ToolTip="{loc:Tr Member_StopShare}" Tag="{Binding}" Click="ModStopShare_Click">
                            <ico:PackIconLucide Kind="MonitorOff" Width="13" Height="13"/>
                        </Button>
                        <Button Style="{StaticResource Btn.IconSm}" Width="24" Height="24"
                                ToolTip="{loc:Tr Member_Kick}" Tag="{Binding}" Click="ModKick_Click"
                                Foreground="{StaticResource Danger}">
                            <ico:PackIconLucide Kind="UserX" Width="13" Height="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter TargetName="MRoot" Property="Background" Value="#2A1520"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ══════════ VIRTUAL LAN MEMBER ROW ══════════ -->
        <DataTemplate DataType="{x:Type local:VlanMemberItem}">
            <Border Background="#12161F" CornerRadius="10" Padding="11,8" Margin="0,0,0,6"
                    BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="9" Height="9" Margin="1,0,10,0"
                             VerticalAlignment="Center" Fill="{Binding StatusBrush}"
                             ToolTip="{Binding StatusLabel}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{StaticResource TxtHi}"
                                   FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding SubLabel}" Foreground="{StaticResource TxtLo}"
                                   FontSize="10.5" Margin="0,1,0,0" Visibility="{Binding SubVisibility}"/>
                    </StackPanel>

                    <!-- The address friends type into the game. Click copies it. -->
                    <Border Grid.Column="2" Background="#1A2030" CornerRadius="8" Padding="10,5"
                            BorderBrush="{StaticResource Stroke}" BorderThickness="1" Cursor="Hand"
                            Margin="8,0,0,0" ToolTip="{loc:Tr Common_ClickToCopy}"
                            Tag="{Binding Ip}" MouseLeftButtonUp="VlanMemberIp_Click">
                        <StackPanel Orientation="Horizontal">
                            <ico:PackIconLucide Kind="Copy" Width="11" Height="11"
                                                Foreground="{StaticResource TxtLo}"
                                                VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding Ip}" FontFamily="Consolas" FontSize="12.5"
                                       Foreground="{StaticResource Accent2}" FontWeight="Bold"
                                       FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="3" Background="{Binding PingBg}" CornerRadius="8" Padding="9,5"
                            Margin="8,0,0,0" MinWidth="64" ToolTip="{loc:Tr Vlan_PingTip}">
                        <TextBlock Text="{Binding PingText}" FontFamily="Consolas" FontSize="12"
                                   Foreground="{Binding PingBrush}" FontWeight="Bold"
                                   FlowDirection="LeftToRight" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             TOP BAR
        ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            FlowDirection="LeftToRight">
                    <Border Width="34" Height="34" CornerRadius="10" Padding="3"
                            Background="#1A1F2E" Margin="0,0,11,0">
                        <!-- logo.png is 1024², drawn at 34pt. Fant is the highest-quality
                             WPF downscaler (a real Lanczos-ish filter); HighQuality is only
                             bilinear+mip and leaves the mark looking mushy at this ratio. -->
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               RenderOptions.BitmapScalingMode="Fant"
                               RenderOptions.EdgeMode="Unspecified"/>
                    </Border>
                    <TextBlock Text="VirtualLAN" Foreground="{StaticResource TxtHi}"
                               FontSize="17" FontWeight="Bold" FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                    <Border Background="#1D2436" CornerRadius="6" Padding="7,2" Margin="9,1,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="BETA" Foreground="{StaticResource Accent2}"
                                   FontSize="9.5" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </Border>

                    <!-- Language toggle. Labelled with the language it switches TO, which
                         is the one convention every user already reads correctly. -->
                    <Button x:Name="LangBtn" Style="{StaticResource Btn.Ghost}"
                            Height="28" MinHeight="28" Padding="11,0" Margin="12,0,0,0"
                            FontSize="11.5" VerticalAlignment="Center"
                            ToolTip="{loc:Tr Lang_Tooltip}" Click="Lang_Click">
                        <StackPanel Orientation="Horizontal">
                            <ico:PackIconLucide Kind="Languages" Width="13" Height="13"
                                                VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Tr Lang_Switch}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="SettingsBtn" Style="{StaticResource Btn.Ghost}"
                            Height="28" MinHeight="28" Padding="11,0" Margin="8,0,0,0"
                            FontSize="11.5" VerticalAlignment="Center"
                            ToolTip="{loc:Tr Settings_Title}" Click="Settings_Click">
                        <StackPanel Orientation="Horizontal">
                            <ico:PackIconLucide Kind="Settings" Width="13" Height="13"
                                                VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{loc:Tr Settings_Title}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Status pill, centred across the whole bar -->
                <Border Grid.Column="0" Grid.ColumnSpan="3"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#151A27" CornerRadius="10" Padding="14,6"
                        BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusEllipse" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Fill><SolidColorBrush x:Name="StatusDot" Color="#5B6377"/></Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="StatusLabel" Text="{loc:Tr Status_Ready}"
                                   Foreground="{StaticResource TxtHi}" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Right side: cancel (busy) or room header -->
                <Grid Grid.Column="2" VerticalAlignment="Center">

                    <!-- Lobby: cancel (shown during busy state) -->
                    <StackPanel x:Name="LobbyHeaderPanel"
                                Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="CancelOpBtn" Style="{StaticResource Btn.Danger}"
                                Height="36" MinHeight="36" Padding="16,0" FontSize="12.5"
                                Visibility="Collapsed"
                                Click="CancelOp_Click">
                            <StackPanel Orientation="Horizontal">
                                <ico:PackIconLucide Kind="X" Width="14" Height="14"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{loc:Tr Common_NeverMind}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Room: host IP chip + leave -->
                    <StackPanel x:Name="RoomHeaderPanel"
                                Orientation="Horizontal" Visibility="Collapsed"
                                VerticalAlignment="Center">
                        <Button x:Name="LeaveCloseBtn" Style="{StaticResource Btn.Danger}"
                                IsEnabled="False" Height="36" MinHeight="36" Padding="16,0" FontSize="12.5"
                                Click="LeaveClose_Click">
                            <StackPanel Orientation="Horizontal">
                                <ico:PackIconLucide Kind="LogOut" Width="14" Height="14"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="LeaveCloseText" Text="{loc:Tr Room_Leave}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <StackPanel x:Name="HostIpPanel" Orientation="Horizontal"
                                    Margin="14,0,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="IpCopiedLabel" Text="{loc:Tr Common_Copied}"
                                       Foreground="{StaticResource Ok}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0"/>
                            <Border Background="#151A27" CornerRadius="9" Padding="11,6" Cursor="Hand"
                                    BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                    ToolTip="{loc:Tr Common_ClickToCopy}"
                                    MouseLeftButtonUp="HostIpBorder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ico:PackIconLucide Kind="Copy" Width="13" Height="13"
                                                        Foreground="{StaticResource TxtLo}"
                                                        VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="HostIpLabel" FontFamily="Consolas" FontSize="12.5"
                                               Foreground="{StaticResource Accent2}" FontWeight="Bold"
                                               FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             MAIN
        ══════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="18,16,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── MEMBER SIDEBAR (right in RTL) ── -->
            <Grid Grid.Column="0" x:Name="RightSidebar" Visibility="Collapsed"
                  Width="228" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,2,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ico:PackIconLucide Kind="Users" Width="14" Height="14"
                                                    Foreground="{StaticResource TxtLo}"
                                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="{loc:Tr Room_Members}" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center"/>
                                <Border Background="#1D2436" CornerRadius="6" Padding="6,1" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="MemberCount" Text="0" FontSize="10"
                                               FontFamily="Consolas" Foreground="{StaticResource TxtMid}"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Btn.IconSm}"
                                    Width="26" Height="26" VerticalAlignment="Center"
                                    ToolTip="{loc:Tr Room_RefreshMembers}" Click="RefreshMembers_Click">
                                <ico:PackIconLucide Kind="RefreshCw" Width="12" Height="12"/>
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="1" x:Name="MemberList"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource BareItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </Border>

                <!-- Connection facts: compact horizontal strip -->
                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ico:PackIconLucide Kind="Network" Width="14" Height="14"
                                                Foreground="{StaticResource TxtLo}"
                                                VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{loc:Tr Conn_Status}" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="1"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock x:Name="DbgRole" Text="—" Style="{StaticResource Val}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr Conn_Role}" Style="{StaticResource Lbl}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="{StaticResource StrokeSoft}" Margin="0,2"/>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock x:Name="DbgPeers" Text="0" Style="{StaticResource Val}"
                                           FontFamily="Consolas" HorizontalAlignment="Center"/>
                                <TextBlock Text="Peer" Style="{StaticResource Lbl}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="3" Background="{StaticResource StrokeSoft}" Margin="0,2"/>

                            <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                <ico:PackIconLucide x:Name="DbgEncIcon" Kind="ShieldOff" Width="14" Height="14"
                                                    Foreground="{StaticResource Warn}"
                                                    HorizontalAlignment="Center"/>
                                <TextBlock x:Name="DbgEncryption" Text="{loc:Tr Conn_NoEncryption}"
                                           Foreground="{StaticResource Warn}" FontSize="10.5"
                                           HorizontalAlignment="Center" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── CENTER ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Voice / media strip -->
                <Border Grid.Row="0" x:Name="VoiceStrip" Visibility="Collapsed"
                        Style="{StaticResource Panel}" Padding="14,11" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mic + speaker, each with its own gain -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="MicBtn" Style="{StaticResource Btn.Icon}"
                                    Background="{StaticResource OkGrad}" IsEnabled="False"
                                    ToolTip="{loc:Tr Audio_Mic}" Click="Mic_Click">
                                <Grid>
                                    <ico:PackIconLucide x:Name="MicIcon" Kind="Mic" Width="18" Height="18"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ico:PackIconLucide x:Name="MicZeroX" Kind="X" Width="13" Height="13"
                                                        Foreground="#EF4444" Visibility="Collapsed"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <StackPanel Width="112" Margin="11,0,14,0" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Audio_Mic}"
                                               Foreground="{StaticResource TxtLo}" FontSize="10"/>
                                    <TextBox Grid.Column="1" x:Name="MicVolBox" Text="100%"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{StaticResource TxtMid}" FontSize="10"
                                             FontFamily="Consolas" HorizontalAlignment="Right"
                                             Width="42" TextAlignment="Right"
                                             VerticalAlignment="Center" FlowDirection="LeftToRight"
                                             LostFocus="MicVolBox_LostFocus" KeyDown="VolBox_KeyDown"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="−" Foreground="{StaticResource TxtLo}"
                                               FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider Grid.Column="1" x:Name="MicSlider" Style="{StaticResource VolSlider}"
                                            Value="100" IsEnabled="False" ValueChanged="MicSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" Text="+" Foreground="{StaticResource TxtLo}"
                                               FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>

                            <Border Width="1" Height="30" Background="{StaticResource StrokeSoft}"
                                    Margin="0,0,14,0" VerticalAlignment="Center"/>

                            <Button x:Name="SpeakerBtn" Style="{StaticResource Btn.Icon}"
                                    Background="{StaticResource OkGrad}" IsEnabled="False"
                                    ToolTip="{loc:Tr Audio_Speaker}" Click="Speaker_Click">
                                <Grid>
                                    <ico:PackIconLucide x:Name="SpeakerIcon" Kind="Volume2" Width="18" Height="18"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ico:PackIconLucide x:Name="SpkZeroX" Kind="X" Width="13" Height="13"
                                                        Foreground="#EF4444" Visibility="Collapsed"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <StackPanel Width="112" Margin="11,0,0,0" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Audio_Speaker}"
                                               Foreground="{StaticResource TxtLo}" FontSize="10"/>
                                    <TextBox Grid.Column="1" x:Name="SpkVolBox" Text="100%"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{StaticResource TxtMid}" FontSize="10"
                                             FontFamily="Consolas" HorizontalAlignment="Right"
                                             Width="42" TextAlignment="Right"
                                             VerticalAlignment="Center" FlowDirection="LeftToRight"
                                             LostFocus="SpkVolBox_LostFocus" KeyDown="VolBox_KeyDown"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="−" Foreground="{StaticResource TxtLo}"
                                               FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider Grid.Column="1" x:Name="SpeakerSlider" Style="{StaticResource VolSlider}"
                                            Value="100" IsEnabled="False" ValueChanged="SpeakerSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" Text="+" Foreground="{StaticResource TxtLo}"
                                               FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="VoiceStatus" Text="—"
                                   Foreground="{StaticResource TxtLo}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="16,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="ScreenShareBtn" Style="{StaticResource Btn.Ghost}"
                                    IsEnabled="False" Padding="13,9"
                                    Click="ScreenShare_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ico:PackIconLucide x:Name="ScreenShareIcon" Kind="MonitorUp"
                                                        Width="15" Height="15"
                                                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="ScreenShareText" Text="{loc:Tr Share_Tab}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════ LOBBY ══════════ -->
                <!-- Scrolls when the window is too small to fit everything (e.g. not
                     maximized); when everything fits, there's nothing to scroll. -->
                <!-- Hidden, not Auto: the wheel still scrolls, but the bar no longer
                     appears down the side of the lobby and reflows the centred content
                     by its own width the moment the window gets short. -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="LobbyActions"
                      HorizontalAlignment="Center" MaxWidth="760" Margin="0,16,0,16">
                    <Grid.RenderTransform><TranslateTransform x:Name="LobbySlide" Y="26"/></Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Grid.Loaded">
                            <BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LobbySlide" Storyboard.TargetProperty="Y"
                                                 From="26" To="0" Duration="0:0:0.42">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                            </Storyboard></BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Profile + Settings card -->
                    <Border Grid.Row="0" x:Name="LobbyTopBar" Style="{StaticResource Card}"
                            Padding="22,20" Margin="0,0,0,16">
                        <StackPanel>

                            <!-- Identity: username -->
                            <StackPanel>
                                <TextBlock Text="{loc:Tr Lobby_NameLabel}" Style="{StaticResource Lbl}" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="UsernameBox" Grid.Column="0"
                                             Style="{StaticResource Inp}" Height="46" FontSize="14" FontWeight="SemiBold"
                                             LostFocus="UsernameBox_LostFocus" KeyDown="UsernameBox_KeyDown"/>
                                    <Button x:Name="SaveUsernameBtn" Grid.Column="2"
                                            Style="{StaticResource Btn.Ghost}"
                                            Height="46" Padding="18,0" Click="SaveUsername_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <ico:PackIconLucide x:Name="SaveIcon" Kind="Save" Width="14" Height="14"
                                                                VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock x:Name="SaveText" Text="{loc:Tr Common_Save}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Network settings toggle -->
                            <Border x:Name="NetSettingsToggle" Margin="0,18,0,0" Cursor="Hand"
                                    CornerRadius="8" MouseLeftButtonUp="NetSettingsToggle_Click">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#171B28"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,1,0,0"
                                        Padding="4,13,4,13">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ico:PackIconLucide Grid.Column="0" Kind="Settings2" Width="13" Height="13"
                                                            Foreground="{StaticResource TxtLo}"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{loc:Tr Lobby_NetSettings}"
                                                   Foreground="{StaticResource TxtLo}" FontSize="12.5" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                        <ico:PackIconLucide x:Name="NetSettingsChevron" Grid.Column="2" Kind="ChevronDown"
                                                            Width="13" Height="13" Foreground="{StaticResource TxtLo}"
                                                            VerticalAlignment="Center" Margin="8,0,0,0"
                                                            RenderTransformOrigin="0.5,0.5">
                                            <ico:PackIconLucide.RenderTransform>
                                                <RotateTransform x:Name="ChevronRotate" Angle="0"/>
                                            </ico:PackIconLucide.RenderTransform>
                                        </ico:PackIconLucide>
                                    </Grid>
                                </Border>
                            </Border>

                            <!-- Network settings (collapsible) -->
                            <Grid x:Name="NetSettingsPanel" Margin="0,14,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Tr Lobby_Port}"
                                           Style="{StaticResource Lbl}" VerticalAlignment="Center"/>
                                <TextBox x:Name="PortBox" Grid.Column="2" Text="42777"
                                         Style="{StaticResource Inp}" FlowDirection="LeftToRight"
                                         FontFamily="Consolas" FontSize="13.5" Height="40" MinHeight="40"
                                         LostFocus="PortBox_LostFocus" KeyDown="PortBox_KeyDown"
                                         PreviewTextInput="PortBox_PreviewTextInput"
                                         DataObject.Pasting="PortBox_Pasting"/>
                                <ComboBox x:Name="AdapterBox" Grid.Column="4"
                                          Style="{StaticResource Cmb}" Height="40"
                                          FlowDirection="LeftToRight"
                                          SelectionChanged="AdapterBox_SelectionChanged"/>
                                <Button Grid.Column="6" Style="{StaticResource Btn.IconSm}"
                                        Width="32" Height="32" VerticalAlignment="Center"
                                        ToolTip="{loc:Tr Lobby_RefreshAdapters}" Click="RefreshAdapters_Click">
                                    <ico:PackIconLucide Kind="RefreshCw" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Divider -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Height="1" Background="{StaticResource StrokeSoft}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{loc:Tr Lobby_RoomDivider}" Margin="14,0"
                                   Foreground="{StaticResource TxtLo}" FontSize="11.5" FontWeight="SemiBold"/>
                        <Border Grid.Column="2" Height="1" Background="{StaticResource StrokeSoft}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Create -->
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="50" Height="50" CornerRadius="14" Margin="0,0,14,0"
                                            Background="{StaticResource AccentGrad}">
                                        <ico:PackIconLucide Kind="Radio" Width="24" Height="24" Foreground="White"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Lobby_CreateTitle}" Foreground="{StaticResource TxtHi}"
                                                   FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{loc:Tr Lobby_RoomSubtitle}" Foreground="{StaticResource TxtLo}"
                                                   FontSize="11.5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="{loc:Tr Lobby_CreateBody}"
                                           Foreground="{StaticResource TxtMid}" FontSize="13"
                                           TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,18"/>
                                <Button x:Name="CreateBtn" Style="{StaticResource Btn.Primary}"
                                        HorizontalAlignment="Stretch" Height="50"
                                        Click="CreateRoom_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ico:PackIconLucide Kind="Plus" Width="17" Height="17"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{loc:Tr Lobby_CreateBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Join -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="50" Height="50" CornerRadius="14" Margin="0,0,14,0"
                                            Background="{StaticResource OkGrad}">
                                        <ico:PackIconLucide Kind="Link" Width="23" Height="23" Foreground="White"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{loc:Tr Lobby_JoinTitle}" Foreground="{StaticResource TxtHi}"
                                                   FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{loc:Tr Lobby_RoomSubtitle}" Foreground="{StaticResource TxtLo}"
                                                   FontSize="11.5" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Foreground="{StaticResource TxtMid}" FontSize="13"
                                           TextWrapping="Wrap" LineHeight="22" Margin="0,0,0,14">
                                    <Run Text="{loc:Tr Lobby_JoinBody}"/>
                                    <Run FontFamily="Consolas" FlowDirection="LeftToRight" Foreground="#8B5CF6">10.88.1.5</Run>
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="9"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="JoinCodeBox" Style="{StaticResource Inp}"
                                             MinWidth="150" MaxWidth="220" HorizontalAlignment="Stretch"
                                             FlowDirection="LeftToRight" FontFamily="Consolas"
                                             FontSize="13.5" Height="50"
                                             PreviewTextInput="JoinCodeBox_PreviewTextInput"
                                             DataObject.Pasting="JoinCodeBox_Pasting"
                                             LostFocus="JoinCodeBox_LostFocus" KeyDown="JoinCodeBox_KeyDown"/>
                                    <Button Grid.Column="2" x:Name="JoinBtn" Style="{StaticResource Btn.Success}"
                                            Padding="20,0" Height="50" Click="Join_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ico:PackIconLucide Kind="Plug" Width="16" Height="16"
                                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{loc:Tr Lobby_JoinBtn}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ══════════ VIRTUAL LAN (standalone — not tied to a Room) ══════════ -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,17">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Width="50" Height="50" CornerRadius="14" Margin="0,0,14,0"
                                        Background="{StaticResource AccentGrad}">
                                    <ico:PackIconLucide Kind="Network" Width="23" Height="23" Foreground="White"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{loc:Tr Vlan_Title}" Foreground="{StaticResource TxtHi}"
                                               FontSize="16" FontWeight="Bold"/>
                                    <TextBlock Text="{loc:Tr Vlan_Subtitle}" Foreground="{StaticResource TxtLo}"
                                               FontSize="11.5" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <!--
                              Room and virtual LAN solve different problems and the names
                              do not make that obvious, so say it outright. Users were
                              expected to infer it and there is no reason they would.
                            -->
                            <Border Background="#141926" CornerRadius="10" Padding="13,10"
                                    Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal">
                                    <ico:PackIconLucide Kind="Info" Width="15" Height="15"
                                                        Foreground="{StaticResource Accent2}"
                                                        VerticalAlignment="Top" Margin="0,2,9,0"/>
                                    <TextBlock Foreground="{StaticResource TxtMid}" FontSize="12"
                                               TextWrapping="Wrap" LineHeight="21" MaxWidth="620">
                                        <Run Text="{loc:Tr Vlan_DiffLead}" FontWeight="Bold"
                                             Foreground="{StaticResource TxtHi}"/>
                                        <Run Text="{loc:Tr Vlan_DiffBody}"/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <!--
                              Two ways in, and both are required: one machine hosts, the
                              rest reach it by its real IP. With only the host button the
                              feature could never connect anybody — every user sat alone
                              on their own adapter.
                            -->
                            <StackPanel x:Name="VlanIdlePanel">
                                <Button x:Name="VlanHostBtn" Style="{StaticResource Btn.Primary}"
                                        HorizontalAlignment="Stretch" Height="50" Click="VlanHost_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ico:PackIconLucide Kind="Radio" Width="17" Height="17"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{loc:Tr Vlan_HostBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Grid Margin="0,14,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Height="1" Background="{StaticResource StrokeSoft}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Vlan_JoinDivider}" Margin="12,0"
                                               Foreground="{StaticResource TxtLo}" FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <Border Grid.Column="2" Height="1" Background="{StaticResource StrokeSoft}"
                                            VerticalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="9"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="VlanJoinIpBox" Grid.Column="0"
                                             Style="{StaticResource Inp}" Height="46"
                                             FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="13.5"
                                             PreviewTextInput="JoinCodeBox_PreviewTextInput"
                                             DataObject.Pasting="JoinCodeBox_Pasting"
                                             KeyDown="VlanJoinIpBox_KeyDown"/>
                                    <Button Grid.Column="2" x:Name="VlanJoinBtn" Style="{StaticResource Btn.Success}"
                                            Height="46" Padding="20,0" Click="VlanJoin_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ico:PackIconLucide Kind="Plug" Width="16" Height="16"
                                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="{loc:Tr Lobby_JoinBtn}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{loc:Tr Vlan_JoinHint}"
                                           Foreground="{StaticResource TxtLo}" FontSize="11"
                                           Margin="2,8,0,0"/>
                            </StackPanel>

                            <!-- Active: assigned IP + disconnect -->
                            <StackPanel x:Name="VlanActivePanel" Visibility="Collapsed">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Vlan_YourIp}" Foreground="{StaticResource TxtLo}"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Background="{StaticResource InputBg}" CornerRadius="10"
                                            BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                            Height="44" Padding="14,0">
                                        <TextBlock x:Name="VlanIpText" Text="—" Foreground="{StaticResource Accent2}"
                                                   FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                                   VerticalAlignment="Center"
                                                   FlowDirection="LeftToRight"/>
                                    </Border>
                                    <Button Grid.Column="2" x:Name="VlanCopyBtn" Style="{StaticResource Btn.Ghost}"
                                            Padding="18,0" Height="44" Margin="8,0,0,0" Click="VlanCopy_Click">
                                        <TextBlock Text="{loc:Tr Common_Copy}" VerticalAlignment="Center"/>
                                    </Button>
                                    <TextBlock Grid.Column="3" x:Name="VlanCopied" Text="✓" Foreground="{StaticResource Ok}"
                                               FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0"/>
                                </Grid>
                                <!--
                                  Host only. The invite is shown, not just copied: people
                                  read it out over voice or type it into a phone, so it has
                                  to be visible. Labelled as a code, never as an "IP", so it
                                  cannot be confused with the game address above it.
                                -->
                                <Grid x:Name="VlanInviteRow" Margin="0,0,0,10" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{loc:Tr Vlan_InviteLabel}" Foreground="{StaticResource TxtLo}"
                                               FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Border Grid.Column="1" Background="#12161F" CornerRadius="10"
                                            BorderBrush="{StaticResource Ok}" BorderThickness="1"
                                            Height="44" Padding="14,0">
                                        <TextBlock x:Name="VlanInviteText" Text="—" Foreground="{StaticResource Ok}"
                                                   FontFamily="Consolas" FontSize="15" FontWeight="Bold"
                                                   VerticalAlignment="Center" FlowDirection="LeftToRight"/>
                                    </Border>
                                    <Button Grid.Column="2" x:Name="VlanInviteBtn" Style="{StaticResource Btn.Ghost}"
                                            Padding="18,0" Height="44" Margin="8,0,0,0" Click="VlanInviteCopy_Click">
                                        <TextBlock Text="{loc:Tr Common_Copy}" VerticalAlignment="Center"/>
                                    </Button>
                                    <TextBlock Grid.Column="3" x:Name="VlanInviteCopied" Text="✓" Foreground="{StaticResource Ok}"
                                               FontSize="13" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                                    <Border Background="#1D2436" CornerRadius="6" Padding="8,2"
                                            VerticalAlignment="Center" Margin="0,0,8,0">
                                        <TextBlock x:Name="VlanRoleText" Text="—" FontSize="10.5"
                                                   FontWeight="Bold" Foreground="{StaticResource Accent2}"/>
                                    </Border>
                                    <TextBlock x:Name="VlanStatusText" Text="" Foreground="{StaticResource TxtLo}"
                                               FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- How the link is doing right now -->
                                <Border Background="#141926" CornerRadius="10" Padding="6,10" Margin="0,2,0,12"
                                        BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Border x:Name="VlanQualityChip" Background="#1D2436" CornerRadius="7"
                                                    Padding="9,3" HorizontalAlignment="Center">
                                                <TextBlock x:Name="VlanQualityText" Text="—" FontSize="11.5" FontWeight="Bold"
                                                           Foreground="{StaticResource TxtMid}"/>
                                            </Border>
                                            <TextBlock Text="{loc:Tr Vlan_Quality}" Style="{StaticResource Lbl}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource StrokeSoft}" Margin="0,2"/>

                                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                            <TextBlock x:Name="VlanPingText" Text="—" Style="{StaticResource Val}"
                                                       FontFamily="Consolas" FontSize="13" HorizontalAlignment="Center"
                                                       FlowDirection="LeftToRight"/>
                                            <TextBlock x:Name="VlanPingLabel" Text="{loc:Tr Vlan_Ping}" Style="{StaticResource Lbl}"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="3" Background="{StaticResource StrokeSoft}" Margin="0,2"/>

                                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                            <TextBlock x:Name="VlanUpText" Text="0 KB/s" Style="{StaticResource Val}"
                                                       FontFamily="Consolas" FontSize="13" HorizontalAlignment="Center"
                                                       FlowDirection="LeftToRight"/>
                                            <TextBlock Text="{loc:Tr Vlan_Upload}" Style="{StaticResource Lbl}"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="5" Background="{StaticResource StrokeSoft}" Margin="0,2"/>

                                        <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                                            <TextBlock x:Name="VlanDownText" Text="0 KB/s" Style="{StaticResource Val}"
                                                       FontFamily="Consolas" FontSize="13" HorizontalAlignment="Center"
                                                       FlowDirection="LeftToRight"/>
                                            <TextBlock Text="{loc:Tr Vlan_Download}" Style="{StaticResource Lbl}"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="7" Background="{StaticResource StrokeSoft}" Margin="0,2"/>

                                        <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                                            <TextBlock x:Name="VlanLossText" Text="0%" Style="{StaticResource Val}"
                                                       FontFamily="Consolas" FontSize="13" HorizontalAlignment="Center"
                                                       FlowDirection="LeftToRight"/>
                                            <TextBlock Text="{loc:Tr Vlan_Loss}" Style="{StaticResource Lbl}"
                                                       HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Who is on the network -->
                                <Grid Margin="2,0,2,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ico:PackIconLucide Kind="Users" Width="14" Height="14"
                                                            Foreground="{StaticResource TxtLo}"
                                                            VerticalAlignment="Center" Margin="0,0,7,0"/>
                                        <TextBlock Text="{loc:Tr Vlan_Members}" Style="{StaticResource SectionLabel}"
                                                   VerticalAlignment="Center"/>
                                        <Border Background="#1D2436" CornerRadius="6" Padding="6,1" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="VlanMemberCount" Text="1" FontSize="10"
                                                       FontFamily="Consolas" Foreground="{StaticResource TxtMid}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{loc:Tr Vlan_MembersHint}"
                                               Foreground="{StaticResource TxtLo}" FontSize="10.5"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <ItemsControl x:Name="VlanMemberList" Margin="0,0,0,6"/>
                                <TextBlock x:Name="VlanAloneText" Text="{loc:Tr Vlan_Alone}"
                                           Foreground="{StaticResource TxtLo}" FontSize="11.5"
                                           TextWrapping="Wrap" Margin="2,0,2,12" Visibility="Collapsed"/>

                                <Button x:Name="VlanDisconnectBtn" Style="{StaticResource Btn.Danger}"
                                        HorizontalAlignment="Stretch" Height="48" Click="VlanDisconnect_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ico:PackIconLucide Kind="Power" Width="16" Height="16"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{loc:Tr Vlan_StopBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Donate -->
                    <Button Grid.Row="4" Style="{StaticResource Btn.Nav}"
                            Foreground="{StaticResource Danger}"
                            HorizontalAlignment="Center" Margin="0,10,0,0"
                            Click="NavDonate_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ico:PackIconLucide Kind="Heart" Width="15" Height="15"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{loc:Tr Nav_Donate}" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
                </ScrollViewer>

                <!-- ══════════ CHAT / FILES / SCREEN SHARE ══════════ -->
                <Border Grid.Row="1" x:Name="ChatPanel" Style="{StaticResource Panel}"
                        Visibility="Collapsed" ClipToBounds="True"
                        AllowDrop="True" DragOver="ChatArea_DragOver" Drop="ChatArea_Drop">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Tab bar -->
                            <RowDefinition Height="*"/>    <!-- Content area -->
                            <RowDefinition Height="Auto"/> <!-- Reply bar -->
                            <RowDefinition Height="Auto"/> <!-- Composer -->
                        </Grid.RowDefinitions>

                        <!-- Tab bar -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1">
                            <Grid Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button x:Name="TabChatBtn" Style="{StaticResource Tab.Active}"
                                            Tag="chat" Click="Tab_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{loc:Tr Tab_Chat}" VerticalAlignment="Center"/>
                                            <!-- Unread count while the user is on another tab or away -->
                                            <Border x:Name="ChatUnreadBadge" Background="{StaticResource Accent}"
                                                    CornerRadius="9" MinWidth="18" Height="18" Padding="5,0"
                                                    Margin="7,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                                <TextBlock x:Name="ChatUnreadText" Text="1" Foreground="White"
                                                           FontSize="10" FontWeight="Bold" FontFamily="Consolas"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="TabFilesBtn" Style="{StaticResource Tab.Btn}"    Content="{loc:Tr Tab_Files}"
                                            Tag="files" Click="Tab_Click"/>
                                    <Button x:Name="TabShareBtn" Style="{StaticResource Tab.Btn}"    Content="{loc:Tr Share_Tab}"
                                            Tag="share" Click="Tab_Click" Visibility="Collapsed"/>
                                </StackPanel>

                                <!-- "X is typing…" — lives up here so it never shifts the composer -->
                                <StackPanel Grid.Column="1" x:Name="TypingPanel" Orientation="Horizontal"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Margin="0,0,12,0" Visibility="Collapsed">
                                    <ico:PackIconLucide Kind="Pencil" Width="12" Height="12"
                                                        Foreground="{StaticResource Accent2}"
                                                        VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TypingText" Foreground="{StaticResource TxtMid}"
                                               FontSize="11.5" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Chat messages. Sunk a shade below the panel so the bubbles read as
                             floating on a canvas, the way a messenger's conversation area does. -->
                        <ListBox Grid.Row="1" x:Name="ChatList"
                                 Background="#0E121C" BorderThickness="0" Padding="8,12"
                                 ItemContainerStyle="{StaticResource BareItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseWheel="ChatList_PreviewMouseWheel"/>

                        <!-- File transfers (separate tab) -->
                        <ListBox Grid.Row="1" x:Name="FileList"
                                 Background="Transparent" BorderThickness="0" Padding="6,10"
                                 ItemContainerStyle="{StaticResource BareItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="Collapsed"/>

                        <!-- Screen share viewer -->
                        <Grid Grid.Row="1" x:Name="ShareViewArea" Background="#080B12" Visibility="Collapsed">
                            <Image x:Name="ScreenShareImg" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SharePlaceholder" Text="{loc:Tr Share_Waiting}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TxtLo}" FontSize="13"
                                       Visibility="Collapsed"/>
                        </Grid>

                        <!-- Reply composer strip (chat tab only) -->
                        <Border Grid.Row="2" x:Name="ReplyBar" Visibility="Collapsed"
                                Background="#151A27" CornerRadius="10"
                                BorderBrush="{StaticResource Accent}" BorderThickness="0,0,3,0"
                                Margin="12,0,12,8" Padding="11,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ico:PackIconLucide Grid.Column="0" Kind="Reply" Width="14" Height="14"
                                                    Foreground="{StaticResource Accent2}"
                                                    VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="ReplyToName" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent2}"/>
                                    <TextBlock x:Name="ReplyToText" FontSize="11.5"
                                               Foreground="{StaticResource TxtMid}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Btn.IconSm}"
                                        ToolTip="{loc:Tr Reply_Cancel}" Click="CancelReply_Click">
                                    <ico:PackIconLucide Kind="X" Width="13" Height="13"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Composer (chat tab only) — pill-shaped, messenger style -->
                        <Border Grid.Row="3" x:Name="Composer" Margin="12,10,12,12"
                                Background="#1A2030" CornerRadius="24"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" x:Name="SendFileBtn" Style="{StaticResource Btn.IconSm}"
                                        Width="40" Height="48" Margin="5,0,0,0"
                                        IsEnabled="False" ToolTip="{loc:Tr Composer_SendFile}"
                                        Click="SendFile_Click">
                                    <ico:PackIconLucide Kind="Paperclip" Width="18" Height="18"/>
                                </Button>

                                <Button Grid.Column="1" x:Name="EmojiBtn" Style="{StaticResource Btn.IconSm}"
                                        Width="40" Height="48" ToolTip="{loc:Tr Composer_Emoji}"
                                        Click="EmojiBtn_Click">
                                    <ico:PackIconLucide Kind="Smile" Width="20" Height="20"/>
                                </Button>

                                <RichTextBox Grid.Column="2" x:Name="ChatInput"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TxtHi}"
                                         CaretBrush="{StaticResource Accent}"
                                         SelectionBrush="{StaticResource Accent}"
                                         SelectionOpacity="0.45"
                                         FontFamily="{StaticResource UiFont}"
                                         FontSize="14" Height="48" Padding="6,0,6,0"
                                         AcceptsReturn="False"
                                         HorizontalScrollBarVisibility="Disabled"
                                         VerticalScrollBarVisibility="Disabled"
                                         PreviewKeyDown="ChatInput_KeyDown"
                                         TextChanged="ChatInput_TextChanged">
                                    <RichTextBox.Template>
                                        <ControlTemplate TargetType="RichTextBox">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                          VerticalAlignment="Center"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          VerticalScrollBarVisibility="Disabled"/>
                                        </ControlTemplate>
                                    </RichTextBox.Template>
                                </RichTextBox>

                                <Button Grid.Column="3" x:Name="SendBtn" Style="{StaticResource Btn.Icon}"
                                        Width="38" Height="38" Margin="5"
                                        Background="{StaticResource AccentGrad}"
                                        ToolTip="{loc:Tr Composer_Send}" Click="SendChat_Click">
                                    <ico:PackIconLucide Kind="Send" Width="16" Height="16" Foreground="White"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiBtn}"
                               Placement="Top" VerticalOffset="-8" HorizontalOffset="-6"
                               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                               Closed="EmojiPopup_Closed">
                            <ctl:EmojiPicker x:Name="EmojiPickerCtl" Margin="10"/>
                        </Popup>
                    </Grid>
                </Border>
            </Grid>

        </Grid>

        <!-- ══════════ UPDATE GATE ══════════ -->
        <!--
          Covers the whole window on launch while the manifest is checked, and again on a
          manual check. Four states share one card: Checking / UpToDate / Available /
          Failed. Declared before the modal overlay so a confirmation raised from inside
          the gate (the release-notes link) still draws on top of it.
        -->
        <Grid x:Name="UpdateGate" Grid.RowSpan="3" Background="#F20A0C11"
              Visibility="Collapsed">
            <Border Background="{StaticResource Elevated}" CornerRadius="18"
                    BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                    Padding="34,30" Width="430"
                    Effect="{StaticResource SoftShadow}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>

                    <!-- Brand mark -->
                    <Border Width="62" Height="62" CornerRadius="18" Padding="7"
                            Background="#1A1F2E" HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               RenderOptions.BitmapScalingMode="Fant"/>
                    </Border>

                    <TextBlock x:Name="UpdateTitle" Text="{loc:Tr Update_CheckTitle}"
                               FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TxtHi}"
                               TextAlignment="Center" HorizontalAlignment="Center"/>

                    <TextBlock x:Name="UpdateMessage" Text="{loc:Tr Common_OneMoment}"
                               FontSize="13" Foreground="{StaticResource TxtMid}"
                               TextWrapping="Wrap" TextAlignment="Center" LineHeight="22"
                               Margin="0,9,0,0"/>

                    <!-- Version pills: current → latest -->
                    <StackPanel x:Name="UpdateVersions" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,16,0,0"
                                FlowDirection="LeftToRight" Visibility="Collapsed">
                        <Border Background="#161B28" CornerRadius="8" Padding="11,5"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                            <TextBlock x:Name="UpdateFromText" FontFamily="Consolas" FontSize="12.5"
                                       Foreground="{StaticResource TxtLo}"/>
                        </Border>
                        <ico:PackIconLucide Kind="ArrowRight" Width="15" Height="15" Margin="9,0"
                                            Foreground="{StaticResource TxtLo}"
                                            VerticalAlignment="Center"/>
                        <Border Background="#1D2436" CornerRadius="8" Padding="11,5"
                                BorderBrush="{StaticResource Accent}" BorderThickness="1">
                            <TextBlock x:Name="UpdateToText" FontFamily="Consolas" FontSize="12.5"
                                       FontWeight="Bold" Foreground="{StaticResource Accent2}"/>
                        </Border>
                    </StackPanel>

                    <!-- Indeterminate sweep while checking, real progress while downloading -->
                    <Border x:Name="UpdateBarTrack" Height="6" CornerRadius="3"
                            Background="#161B28" Margin="0,22,0,0" ClipToBounds="True">
                        <Grid HorizontalAlignment="Stretch">
                            <Border x:Name="UpdateBarFill" CornerRadius="3"
                                    Background="{StaticResource AccentGrad}"
                                    HorizontalAlignment="Left" Width="0"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="UpdateHint" Text=""
                               FontSize="11.5" Foreground="{StaticResource TxtLo}"
                               TextAlignment="Center" Margin="0,9,0,0"
                               Visibility="Collapsed"/>

                    <StackPanel x:Name="UpdateButtons" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,22,0,0"
                                Visibility="Collapsed">
                        <Button x:Name="UpdateNowBtn" Style="{StaticResource Btn.Primary}"
                                Height="46" Padding="26,0" Margin="0,0,9,0"
                                Click="UpdateNow_Click">
                            <StackPanel Orientation="Horizontal">
                                <ico:PackIconLucide Kind="Download" Width="16" Height="16"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{loc:Tr Update_Now}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="UpdateLaterBtn" Style="{StaticResource Btn.Ghost}"
                                Height="46" Padding="22,0" Click="UpdateLater_Click"
                                Content="{loc:Tr Common_Later}"/>
                        <Button x:Name="UpdateCloseBtn" Style="{StaticResource Btn.Ghost}"
                                Height="46" Padding="26,0" Click="UpdateLater_Click"
                                Content="{loc:Tr Common_Ok}" Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Release notes. Navigation bubbles to the window-level
                         RequestNavigate handler, which confirms before opening. -->
                    <TextBlock x:Name="UpdateNotesLink" HorizontalAlignment="Center"
                               Margin="0,14,0,0" Visibility="Collapsed">
                        <Hyperlink x:Name="UpdateNotesHyper"
                                   Foreground="{StaticResource Accent2}"
                                   TextDecorations="None">
                            <Run Text="{loc:Tr Update_Notes}" FontSize="11.5"/>
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════ VLAN PRE-FLIGHT ══════════ -->
        <!--
          Runs before the virtual LAN comes up and shows every condition that can quietly
          break it, each resolving to a tick, a warning or a cross. The rows are built in
          code so they can update live as each check finishes.
        -->
        <Grid x:Name="VlanPreflight" Grid.RowSpan="3" Background="#F20A0C11"
              Visibility="Collapsed">
            <Border Background="{StaticResource Elevated}" CornerRadius="18"
                    BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                    Padding="32,28" Width="500"
                    Effect="{StaticResource SoftShadow}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                        <Border Width="48" Height="48" CornerRadius="14" Margin="0,0,14,0"
                                Background="{StaticResource AccentGrad}">
                            <ico:PackIconLucide Kind="Network" Width="23" Height="23" Foreground="White"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{loc:Tr Preflight_Title}" FontSize="17" FontWeight="Bold"
                                       Foreground="{StaticResource TxtHi}"/>
                            <TextBlock x:Name="PreflightSubtitle" Text="{loc:Tr Common_OneMoment}" FontSize="12"
