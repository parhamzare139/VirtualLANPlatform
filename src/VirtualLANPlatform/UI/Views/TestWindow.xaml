<Window x:Class="VirtualLANPlatform.UI.Views.TestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:VirtualLANPlatform.UI.Views"
        xmlns:ui="clr-namespace:VirtualLANPlatform.UI"
        xmlns:chat="clr-namespace:VirtualLANPlatform.Core.Chat"
        xmlns:ctl="clr-namespace:VirtualLANPlatform.UI.Controls"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:ico="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="Virtual LAN Platform"
        Height="760" Width="1180"
        MinHeight="640" MinWidth="980"
        FlowDirection="RightToLeft"
        Background="{StaticResource Base}"
        FontFamily="Vazir, Segoe UI, Tahoma"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Opacity="0"
        Closing="Window_Closing">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>

        <!--
          Emoji.Wpf.TextBox is a shell whose template hosts an inner
          Emoji.Wpf.RichTextBox; properties set on the shell don't reach it.
          This implicit style is how the composer gets its dark treatment.
          Keyed styles (MsgBody below) still win where they're applied.
        -->
        <Style TargetType="{x:Type emoji:RichTextBox}">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="Padding"                  Value="0"/>
            <Setter Property="Foreground"               Value="{StaticResource TxtHi}"/>
            <Setter Property="CaretBrush"               Value="{StaticResource Accent}"/>
            <Setter Property="SelectionBrush"           Value="{StaticResource Accent}"/>
            <Setter Property="FontSize"                 Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Hidden"/>
            <Style.Resources>
                <Style TargetType="Paragraph"><Setter Property="Margin" Value="0"/></Style>
            </Style.Resources>
        </Style>

        <!-- Read-only rich text for chat messages — supports clickable hyperlinks. -->
        <Style x:Key="MsgBody" TargetType="{x:Type RichTextBox}">
            <Setter Property="IsReadOnly"             Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
            <Setter Property="IsDocumentEnabled"      Value="True"/>
            <Setter Property="Background"             Value="Transparent"/>
            <Setter Property="BorderThickness"        Value="0"/>
            <Setter Property="Padding"                Value="0"/>
            <Setter Property="Margin"                 Value="0,2,0,0"/>
            <Setter Property="Foreground"             Value="{StaticResource TxtHi}"/>
            <Setter Property="FontSize"               Value="13.5"/>
            <Setter Property="FontFamily"             Value="Vazir, Segoe UI, Tahoma"/>
            <Setter Property="SelectionBrush"         Value="{StaticResource Accent}"/>
            <Setter Property="SelectionOpacity"       Value="0.45"/>
            <Setter Property="Cursor"                 Value="IBeam"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RichTextBox}">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Disabled"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="Paragraph">
                    <Setter Property="Margin"     Value="0"/>
                    <Setter Property="LineHeight" Value="20"/>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Tab button styles (used inside ChatPanel) -->
        <ControlTemplate x:Key="Tpl.Tab" TargetType="Button">
            <Border x:Name="Root" Background="Transparent"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#0D1219"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="Tab.Btn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{StaticResource TxtLo}"/>
            <Setter Property="BorderBrush"     Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding"         Value="14,10"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template"        Value="{StaticResource Tpl.Tab}"/>
        </Style>
        <Style x:Key="Tab.Active" TargetType="Button" BasedOn="{StaticResource Tab.Btn}">
            <Setter Property="Foreground"  Value="{StaticResource TxtHi}"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
        </Style>

        <!-- ══════════ CHAT MESSAGE ══════════ -->
        <DataTemplate DataType="{x:Type chat:ChatMessage}">
            <Border x:Name="Root" Background="#1C2236" CornerRadius="10"
                    Padding="8,6" Margin="0,1" Opacity="0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.28"/>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                From="0,9,0,-8" To="0,1,0,1" Duration="0:0:0.28">
                                <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                            </ThicknessAnimation>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.12"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Actions" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border x:Name="Avatar" Grid.Column="0" Width="34" Height="34" CornerRadius="999"
                            Margin="0,1,10,0" VerticalAlignment="Top"
                            Background="{StaticResource AccentGrad}">
                        <TextBlock Text="{Binding Sender, Converter={StaticResource Initial}}"
                                   Foreground="White" FontSize="14" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <!-- Header: name · time · hover actions -->
                        <Grid x:Name="HeaderRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding Sender}" FontSize="12.5" FontWeight="Bold"
                                           Foreground="{StaticResource TxtHi}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SentAt, StringFormat='HH:mm'}"
                                           Foreground="{StaticResource TxtLo}" FontSize="10.5"
                                           FontFamily="Consolas" FlowDirection="LeftToRight"
                                           VerticalAlignment="Center" Margin="8,1,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Opacity="0">
                                <Button Style="{StaticResource Btn.IconSm}" ToolTip="پاسخ"
                                        Click="ReplyTo_Click"
                                        Visibility="{Binding IsAlive, Converter={StaticResource BoolVis}}">
                                    <ico:PackIconLucide Kind="Reply" Width="14" Height="14"/>
                                </Button>
                                <Button Style="{StaticResource Btn.IconSm}" ToolTip="حذف پیام"
                                        Click="DeleteMsg_Click"
                                        Visibility="{Binding CanModify, Converter={StaticResource BoolVis}}">
                                    <ico:PackIconLucide Kind="Trash2" Width="14" Height="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Quoted message -->
                        <Border Visibility="{Binding ReplyVisibility}"
                                Background="#161B28" CornerRadius="8"
                                BorderBrush="{StaticResource Accent}" BorderThickness="0,0,3,0"
                                Padding="9,5" Margin="0,5,0,1"
                                Tag="{Binding ReplyToId}" Cursor="Hand"
                                MouseLeftButtonUp="ReplyQuote_Click">
                            <StackPanel>
                                <TextBlock Text="{Binding ReplyToSender}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent2}"/>
                                <TextBlock Text="{Binding ReplyToText}" FontSize="11.5"
                                           Foreground="{StaticResource TxtMid}"
                                           TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Body: attached property avoids WPF's restriction on binding Document directly -->
                        <RichTextBox x:Name="Body" Style="{StaticResource MsgBody}"
                                     ui:RichTextBoxHelper.DocumentSource="{Binding Text, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                    <Setter TargetName="Body" Property="Foreground" Value="{StaticResource TxtLo}"/>
                    <Setter TargetName="Body" Property="FontStyle"  Value="Italic"/>
                    <Setter TargetName="Body" Property="FontSize"   Value="12.5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOwn}" Value="True">
                    <Setter TargetName="Root" Property="Background" Value="#1A2850"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ShowHeader}" Value="False">
                    <Setter TargetName="Avatar"    Property="Opacity"    Value="0"/>
                    <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Root"      Property="Padding"    Value="8,2,8,4"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ══════════ FILE CARD ══════════ -->
        <DataTemplate DataType="{x:Type local:FileNotification}">
            <Border x:Name="FileRoot" Background="{StaticResource CardGrad}" CornerRadius="12"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                    Padding="12,10" Margin="8,4" Opacity="0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin"
                                                From="8,13,8,-5" To="8,4,8,4" Duration="0:0:0.3">
                                <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                            </ThicknessAnimation>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="FileActions" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.12"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="FileActions" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="11"
                            Background="{StaticResource AccentGrad}" Margin="0,0,12,0">
                        <ico:PackIconLucide Kind="Paperclip" Width="19" Height="19"
                                            Foreground="White"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TxtHi}"
                                   FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding SizeText}" Foreground="{StaticResource TxtLo}"
                                       FontSize="11" FontFamily="Consolas" FlowDirection="LeftToRight"/>
                            <TextBlock Text="  ·  " Foreground="{StaticResource TxtLo}" FontSize="11"/>
                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource TxtMid}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel x:Name="FileActions" Orientation="Horizontal" Opacity="0" Margin="0,0,6,0">
                            <Button Style="{StaticResource Btn.IconSm}" ToolTip="پاسخ"
                                    Click="ReplyToFile_Click">
                                <ico:PackIconLucide Kind="Reply" Width="14" Height="14"/>
                            </Button>
                        </StackPanel>
                        <Button Style="{StaticResource Btn.Success}"
                                IsEnabled="{Binding CanDownload}"
                                Visibility="{Binding DownloadVisibility}"
                                Padding="13,7" FontSize="12" Margin="6,0,0,0"
                                Click="DownloadFile_Click">
                            <StackPanel Orientation="Horizontal">
                                <ico:PackIconLucide Kind="Download" Width="14" Height="14"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="دانلود" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ══════════ MEMBER ROW ══════════ -->
        <DataTemplate DataType="{x:Type local:MemberItem}">
            <Border x:Name="MRoot" Background="Transparent" CornerRadius="9"
                    Padding="7,6" Margin="0,1" Opacity="0">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.3"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Mod" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.12"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Mod" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Width="28" Height="28" Margin="0,0,9,0">
                        <Border CornerRadius="999" Background="{StaticResource AccentGrad}"/>
                        <TextBlock Text="{Binding Initial}" Foreground="White"
                                   FontSize="12" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Ellipse Width="9" Height="9" Fill="{StaticResource Ok}"
                                 Stroke="{StaticResource Surface}" StrokeThickness="2"
                                 HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username}" Foreground="{StaticResource TxtHi}"
                                   FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding RoleLabel}" Foreground="{StaticResource TxtLo}"
                                   FontSize="10" Visibility="{Binding RoleVisibility}"/>
                    </StackPanel>

                    <StackPanel x:Name="Mod" Grid.Column="2" Orientation="Horizontal"
                                Opacity="0" Visibility="{Binding ModVisibility}">
                        <Button Style="{StaticResource Btn.IconSm}" Width="24" Height="24"
                                ToolTip="{Binding MuteTip}" Tag="{Binding}" Click="ModMute_Click">
                            <ico:PackIconLucide Kind="{Binding MuteIcon}" Width="13" Height="13"/>
                        </Button>
                        <Button Style="{StaticResource Btn.IconSm}" Width="24" Height="24"
                                ToolTip="قطع اشتراک صفحه" Tag="{Binding}" Click="ModStopShare_Click">
                            <ico:PackIconLucide Kind="MonitorOff" Width="13" Height="13"/>
                        </Button>
                        <Button Style="{StaticResource Btn.IconSm}" Width="24" Height="24"
                                ToolTip="اخراج از Room" Tag="{Binding}" Click="ModKick_Click"
                                Foreground="{StaticResource Danger}">
                            <ico:PackIconLucide Kind="UserX" Width="13" Height="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter TargetName="MRoot" Property="Background" Value="#2A1520"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             TOP BAR
        ══════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            FlowDirection="LeftToRight">
                    <Border Width="30" Height="30" CornerRadius="9" Padding="3"
                            Background="#1A1F2E" Margin="0,0,10,0">
                        <Image Source="pack://application:,,,/Assets/logo.png"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="VirtualLAN" Foreground="{StaticResource TxtHi}"
                               FontSize="15.5" FontWeight="Bold" FontFamily="Segoe UI"
                               VerticalAlignment="Center"/>
                    <Border Background="#1D2436" CornerRadius="6" Padding="6,2" Margin="9,1,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="BETA" Foreground="{StaticResource Accent2}"
                                   FontSize="9" FontWeight="Bold" FontFamily="Segoe UI"/>
                    </Border>
                </StackPanel>

                <!-- Status pill, centred across the whole bar -->
                <Border Grid.Column="0" Grid.ColumnSpan="3"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="#151A27" CornerRadius="10" Padding="14,6"
                        BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                        IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusEllipse" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1"/>
                                </Ellipse.RenderTransform>
                                <Ellipse.Fill><SolidColorBrush x:Name="StatusDot" Color="#5B6377"/></Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <TextBlock x:Name="StatusLabel" Text="آماده"
                                   Foreground="{StaticResource TxtHi}" FontSize="12.5"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Lobby: cancel only -->
                <StackPanel x:Name="LobbyHeaderPanel" Grid.Column="2"
                            Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CancelOpBtn" Style="{StaticResource Btn.Danger}"
                            Height="34" Padding="14,0" Visibility="Collapsed"
                            Click="CancelOp_Click">
                        <StackPanel Orientation="Horizontal">
                            <ico:PackIconLucide Kind="X" Width="14" Height="14"
                                                VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="لغو عملیات" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Room: host IP chip + leave -->
                <StackPanel x:Name="RoomHeaderPanel" Grid.Column="2"
                            Orientation="Horizontal" Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <Button x:Name="LeaveCloseBtn" Style="{StaticResource Btn.Danger}"
                            IsEnabled="False" Padding="14,8" FontSize="12"
                            Click="LeaveClose_Click">
                        <StackPanel Orientation="Horizontal">
                            <ico:PackIconLucide Kind="LogOut" Width="14" Height="14"
                                                VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="LeaveCloseText" Text="خروج از Room" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <StackPanel x:Name="HostIpPanel" Orientation="Horizontal"
                                Margin="14,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="IpCopiedLabel" Text="کپی شد ✓"
                                   Foreground="{StaticResource Ok}" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,10,0" Opacity="0"/>
                        <Border Background="#151A27" CornerRadius="9" Padding="11,6" Cursor="Hand"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                                ToolTip="کلیک برای کپی"
                                MouseLeftButtonUp="HostIpBorder_Click">
                            <StackPanel Orientation="Horizontal">
                                <ico:PackIconLucide Kind="Copy" Width="13" Height="13"
                                                    Foreground="{StaticResource TxtLo}"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="HostIpLabel" FontFamily="Consolas" FontSize="12.5"
                                           Foreground="{StaticResource Accent2}" FontWeight="Bold"
                                           FlowDirection="LeftToRight" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             MAIN
        ══════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="18,16,18,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- ── MEMBER SIDEBAR (right in RTL) ── -->
            <Grid Grid.Column="0" x:Name="RightSidebar" Visibility="Collapsed"
                  Width="228" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource Panel}" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="4,2,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ico:PackIconLucide Kind="Users" Width="14" Height="14"
                                                    Foreground="{StaticResource TxtLo}"
                                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="اعضای Room" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center"/>
                                <Border Background="#1D2436" CornerRadius="6" Padding="6,1" Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="MemberCount" Text="0" FontSize="10"
                                               FontFamily="Consolas" Foreground="{StaticResource TxtMid}"/>
                                </Border>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource Btn.IconSm}"
                                    Width="22" Height="22" VerticalAlignment="Center"
                                    ToolTip="بروزرسانی لیست اعضا" Click="RefreshMembers_Click">
                                <ico:PackIconLucide Kind="RefreshCw" Width="12" Height="12"/>
                            </Button>
                        </Grid>

                        <ListBox Grid.Row="1" x:Name="MemberList"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 ItemContainerStyle="{StaticResource BareItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                    </Grid>
                </Border>

                <!-- Connection facts -->
                <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ico:PackIconLucide Kind="Network" Width="14" Height="14"
                                                Foreground="{StaticResource TxtLo}"
                                                VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="وضعیت اتصال" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Two explicit columns: under RTL, HorizontalAlignment is
                             mirrored, so overlaying label and value in one cell collides. -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="نقش" Style="{StaticResource Lbl}"/>
                            <!-- HorizontalAlignment is mirrored under RTL: Right = visual left. -->
                            <TextBlock Grid.Column="1" x:Name="DbgRole" Text="—"
                                       Style="{StaticResource Val}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="تعداد Peer" Style="{StaticResource Lbl}"/>
                            <TextBlock Grid.Column="1" x:Name="DbgPeers" Text="0"
                                       Style="{StaticResource Val}" FontFamily="Consolas"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="رمزنگاری" Style="{StaticResource Lbl}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <ico:PackIconLucide x:Name="DbgEncIcon" Kind="ShieldOff"
                                                    Width="13" Height="13"
                                                    Foreground="{StaticResource Warn}"
                                                    VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="DbgEncryption" Text="بدون رمز"
                                           Foreground="{StaticResource Warn}" FontSize="11"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── CENTER ── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Voice / media strip -->
                <Border Grid.Row="0" x:Name="VoiceStrip" Visibility="Collapsed"
                        Style="{StaticResource Panel}" Padding="14,11" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Mic + speaker, each with its own gain -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="MicBtn" Style="{StaticResource Btn.Icon}"
                                    Background="{StaticResource OkGrad}" IsEnabled="False"
                                    ToolTip="میکروفون" Click="Mic_Click">
                                <Grid>
                                    <ico:PackIconLucide x:Name="MicIcon" Kind="Mic" Width="18" Height="18"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ico:PackIconLucide x:Name="MicZeroX" Kind="X" Width="13" Height="13"
                                                        Foreground="#EF4444" Visibility="Collapsed"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <StackPanel Width="112" Margin="11,0,18,0" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="میکروفون"
                                               Foreground="{StaticResource TxtLo}" FontSize="10"/>
                                    <TextBox Grid.Column="1" x:Name="MicVolBox" Text="100%"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{StaticResource TxtMid}" FontSize="10"
                                             FontFamily="Consolas" HorizontalAlignment="Right"
                                             Width="42" TextAlignment="Right"
                                             VerticalAlignment="Center" FlowDirection="LeftToRight"
                                             LostFocus="MicVolBox_LostFocus" KeyDown="VolBox_KeyDown"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="−" Foreground="{StaticResource TxtLo}"
                                               FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider Grid.Column="1" x:Name="MicSlider" Style="{StaticResource VolSlider}"
                                            Value="100" IsEnabled="False" ValueChanged="MicSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" Text="+" Foreground="{StaticResource TxtLo}"
                                               FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>

                            <Button x:Name="SpeakerBtn" Style="{StaticResource Btn.Icon}"
                                    Background="{StaticResource OkGrad}" IsEnabled="False"
                                    ToolTip="اسپیکر" Click="Speaker_Click">
                                <Grid>
                                    <ico:PackIconLucide x:Name="SpeakerIcon" Kind="Volume2" Width="18" Height="18"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <ico:PackIconLucide x:Name="SpkZeroX" Kind="X" Width="13" Height="13"
                                                        Foreground="#EF4444" Visibility="Collapsed"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                            <StackPanel Width="112" Margin="11,0,0,0" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="اسپیکر"
                                               Foreground="{StaticResource TxtLo}" FontSize="10"/>
                                    <TextBox Grid.Column="1" x:Name="SpkVolBox" Text="100%"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{StaticResource TxtMid}" FontSize="10"
                                             FontFamily="Consolas" HorizontalAlignment="Right"
                                             Width="42" TextAlignment="Right"
                                             VerticalAlignment="Center" FlowDirection="LeftToRight"
                                             LostFocus="SpkVolBox_LostFocus" KeyDown="VolBox_KeyDown"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="−" Foreground="{StaticResource TxtLo}"
                                               FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <Slider Grid.Column="1" x:Name="SpeakerSlider" Style="{StaticResource VolSlider}"
                                            Value="100" IsEnabled="False" ValueChanged="SpeakerSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="2" Text="+" Foreground="{StaticResource TxtLo}"
                                               FontSize="14" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Grid.Column="1" x:Name="VoiceStatus" Text="—"
                                   Foreground="{StaticResource TxtLo}" FontSize="11"
                                   TextTrimming="CharacterEllipsis" Margin="16,0"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="SendFileBtn" Style="{StaticResource Btn.Ghost}"
                                    IsEnabled="False" Margin="0,0,8,0" Padding="13,9"
                                    Click="SendFile_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ico:PackIconLucide Kind="Paperclip" Width="15" Height="15"
                                                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock Text="ارسال فایل" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ScreenShareBtn" Style="{StaticResource Btn.Ghost}"
                                    IsEnabled="False" Padding="13,9"
                                    Click="ScreenShare_Click">
                                <StackPanel Orientation="Horizontal">
                                    <ico:PackIconLucide x:Name="ScreenShareIcon" Kind="MonitorUp"
                                                        Width="15" Height="15"
                                                        VerticalAlignment="Center" Margin="0,0,7,0"/>
                                    <TextBlock x:Name="ScreenShareText" Text="اشتراک صفحه"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════ LOBBY ══════════ -->
                <Grid x:Name="LobbyActions" Grid.Row="1" VerticalAlignment="Center">
                    <Grid.RenderTransform><TranslateTransform x:Name="LobbySlide" Y="26"/></Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Grid.Loaded">
                            <BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="LobbySlide" Storyboard.TargetProperty="Y"
                                                 From="26" To="0" Duration="0:0:0.42">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                            </Storyboard></BeginStoryboard>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Create -->
                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="46" Height="46" CornerRadius="13" Margin="0,0,14,0"
                                            Background="{StaticResource AccentGrad}">
                                        <ico:PackIconLucide Kind="Radio" Width="22" Height="22" Foreground="White"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="ایجاد Room" Foreground="{StaticResource TxtHi}"
                                                   FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="نقش: هاست" Foreground="{StaticResource TxtLo}"
                                                   FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="یک Room بسازید و IP خود را با مهمانان به اشتراک بگذارید."
                                           Foreground="{StaticResource TxtMid}" FontSize="12.5"
                                           TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,18"/>
                                <Button x:Name="CreateBtn" Style="{StaticResource Btn.Primary}"
                                        HorizontalAlignment="Stretch" Padding="0,12"
                                        Click="CreateRoom_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <ico:PackIconLucide Kind="Plus" Width="16" Height="16"
                                                            VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="ساخت Room" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Join -->
                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                    <Border Width="46" Height="46" CornerRadius="13" Margin="0,0,14,0"
                                            Background="{StaticResource OkGrad}">
                                        <ico:PackIconLucide Kind="Link" Width="21" Height="21" Foreground="White"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="اتصال به Room" Foreground="{StaticResource TxtHi}"
                                                   FontSize="15" FontWeight="Bold"/>
                                        <TextBlock Text="نقش: مهمان" Foreground="{StaticResource TxtLo}"
                                                   FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Foreground="{StaticResource TxtMid}" FontSize="12.5"
                                           TextWrapping="Wrap" LineHeight="21" Margin="0,0,0,14">
                                    <Run>IP هاست را وارد کنید (مثال: </Run>
                                    <Run FontFamily="Consolas" FlowDirection="LeftToRight" Foreground="#8B5CF6">10.88.1.5</Run>
                                    <Run>)</Run>
                                </TextBlock>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="9"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="JoinCodeBox" Style="{StaticResource Inp}"
                                             FlowDirection="LeftToRight" FontFamily="Consolas"
                                             FontSize="13" Height="42"/>
                                    <Button Grid.Column="2" x:Name="JoinBtn" Style="{StaticResource Btn.Success}"
                                            Padding="20,0" Height="42" Click="Join_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ico:PackIconLucide Kind="Plug" Width="15" Height="15"
                                                                VerticalAlignment="Center" Margin="0,0,7,0"/>
                                            <TextBlock Text="اتصال" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Settings -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="20,16"
                            x:Name="SettingsCard">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ico:PackIconLucide Kind="Settings2" Width="14" Height="14"
                                                    Foreground="{StaticResource TxtLo}"
                                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="تنظیمات شبکه" Style="{StaticResource SectionLabel}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="پورت اتصال" Style="{StaticResource Lbl}" Margin="2,0,0,6"/>
                                    <TextBox x:Name="PortBox" Text="42777" Style="{StaticResource Inp}"
                                             FlowDirection="LeftToRight" FontFamily="Consolas" FontSize="13"
                                             Height="38" LostFocus="PortBox_LostFocus" KeyDown="PortBox_KeyDown"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Grid Margin="2,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="آداپتور شبکه" Style="{StaticResource Lbl}"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Style="{StaticResource Btn.IconSm}"
                                                Width="22" Height="22" ToolTip="بروزرسانی آداپتورها"
                                                Click="RefreshAdapters_Click">
                                            <ico:PackIconLucide Kind="RefreshCw" Width="12" Height="12"/>
                                        </Button>
                                    </Grid>
                                    <ComboBox x:Name="AdapterBox" Style="{StaticResource Cmb}"
                                              Height="38" FlowDirection="LeftToRight"
                                              SelectionChanged="AdapterBox_SelectionChanged"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Donate -->
                    <Button Grid.Row="2" Style="{StaticResource Btn.Nav}"
                            Foreground="{StaticResource Danger}"
                            HorizontalAlignment="Center" Margin="0,10,0,0"
                            Click="NavDonate_Click">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ico:PackIconLucide Kind="Heart" Width="14" Height="14"
                                                VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="حمایت از پروژه" FontSize="12.5" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ══════════ CHAT / FILES / SCREEN SHARE ══════════ -->
                <Border Grid.Row="1" x:Name="ChatPanel" Style="{StaticResource Panel}"
                        Visibility="Collapsed" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Tab bar -->
                            <RowDefinition Height="*"/>    <!-- Content area -->
                            <RowDefinition Height="Auto"/> <!-- Reply bar -->
                            <RowDefinition Height="Auto"/> <!-- Composer -->
                        </Grid.RowDefinitions>

                        <!-- Tab bar -->
                        <Border Grid.Row="0" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal" Margin="4,0">
                                <Button x:Name="TabChatBtn"  Style="{StaticResource Tab.Active}" Content="چت"
                                        Tag="chat"  Click="Tab_Click"/>
                                <Button x:Name="TabFilesBtn" Style="{StaticResource Tab.Btn}"    Content="فایل‌ها"
                                        Tag="files" Click="Tab_Click"/>
                                <Button x:Name="TabShareBtn" Style="{StaticResource Tab.Btn}"    Content="اشتراک صفحه"
                                        Tag="share" Click="Tab_Click" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>

                        <!-- Chat messages -->
                        <ListBox Grid.Row="1" x:Name="ChatList"
                                 Background="Transparent" BorderThickness="0" Padding="6,10"
                                 ItemContainerStyle="{StaticResource BareItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseWheel="ChatList_PreviewMouseWheel"/>

                        <!-- File transfers (separate tab) -->
                        <ListBox Grid.Row="1" x:Name="FileList"
                                 Background="Transparent" BorderThickness="0" Padding="6,10"
                                 ItemContainerStyle="{StaticResource BareItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Visibility="Collapsed"/>

                        <!-- Screen share viewer -->
                        <Grid Grid.Row="1" x:Name="ShareViewArea" Background="#080B12" Visibility="Collapsed">
                            <Image x:Name="ScreenShareImg" Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SharePlaceholder" Text="در انتظار تصویر..."
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource TxtLo}" FontSize="13"
                                       Visibility="Collapsed"/>
                        </Grid>

                        <!-- Reply composer strip (chat tab only) -->
                        <Border Grid.Row="2" x:Name="ReplyBar" Visibility="Collapsed"
                                Background="#151A27" CornerRadius="10"
                                BorderBrush="{StaticResource Accent}" BorderThickness="0,0,3,0"
                                Margin="12,0,12,8" Padding="11,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ico:PackIconLucide Grid.Column="0" Kind="Reply" Width="14" Height="14"
                                                    Foreground="{StaticResource Accent2}"
                                                    VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="ReplyToName" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Accent2}"/>
                                    <TextBlock x:Name="ReplyToText" FontSize="11.5"
                                               Foreground="{StaticResource TxtMid}"
                                               TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource Btn.IconSm}"
                                        ToolTip="لغو پاسخ" Click="CancelReply_Click">
                                    <ico:PackIconLucide Kind="X" Width="13" Height="13"/>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Composer (chat tab only) -->
                        <Border Grid.Row="3" x:Name="Composer" Margin="12,0,12,12"
                                Background="{StaticResource InputBg}" CornerRadius="12"
                                BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" x:Name="EmojiBtn" Style="{StaticResource Btn.IconSm}"
                                        Width="38" Height="44" ToolTip="ایموجی"
                                        Click="EmojiBtn_Click">
                                    <ico:PackIconLucide Kind="Smile" Width="19" Height="19"/>
                                </Button>

                                <TextBox Grid.Column="1" x:Name="ChatInput"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="{StaticResource TxtHi}"
                                         CaretBrush="{StaticResource Accent}"
                                         SelectionBrush="{StaticResource Accent}"
                                         SelectionOpacity="0.45"
                                         FontFamily="Vazir, Segoe UI, Tahoma"
                                         FontSize="13.5" Height="44" Padding="4,0,4,0"
                                         VerticalContentAlignment="Center"
                                         PreviewKeyDown="ChatInput_KeyDown"/>

                                <Button Grid.Column="2" x:Name="SendBtn" Style="{StaticResource Btn.Icon}"
                                        Width="34" Height="34" Margin="5"
                                        Background="{StaticResource AccentGrad}"
                                        ToolTip="ارسال" Click="SendChat_Click">
                                    <ico:PackIconLucide Kind="Send" Width="15" Height="15" Foreground="White"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Popup x:Name="EmojiPopup" PlacementTarget="{Binding ElementName=EmojiBtn}"
                               Placement="Top" VerticalOffset="-8" HorizontalOffset="-6"
                               AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                               Closed="EmojiPopup_Closed">
                            <ctl:EmojiPicker x:Name="EmojiPickerCtl" Margin="10"/>
                        </Popup>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── PROFILE SIDEBAR (left in RTL) — lobby only ── -->
            <Grid Grid.Column="2" x:Name="ProfileSidebar" Width="186" Margin="16,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="UsernameSection" Grid.Row="0" Style="{StaticResource Panel}"
                        Padding="14,14,14,13">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ico:PackIconLucide Kind="CircleUserRound" Width="14" Height="14"
                                                Foreground="{StaticResource TxtLo}"
                                                VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="نام کاربری" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBox x:Name="UsernameBox" Text="کاربر" Style="{StaticResource Inp}" Height="38"/>
                        <Button x:Name="SaveUsernameBtn" Style="{StaticResource Btn.Ghost}"
                                Margin="0,8,0,0" HorizontalAlignment="Stretch" Height="34" Padding="0"
                                Click="SaveUsername_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ico:PackIconLucide x:Name="SaveIcon" Kind="Save" Width="14" Height="14"
                                                    VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock x:Name="SaveText" Text="ذخیره" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>

        <!-- ══════════ TOAST OVERLAY ══════════ -->
        <StackPanel x:Name="ToastPanel" Grid.RowSpan="3"
                    VerticalAlignment="Bottom" HorizontalAlignment="Left"
                    Margin="0,0,20,20" Width="290"
                    IsHitTestVisible="False"/>

        <!-- ══════════ MODAL OVERLAY ══════════ -->
        <Grid x:Name="ModalOverlay" Grid.RowSpan="3" Background="#B0000000"
              Visibility="Collapsed" MouseLeftButtonDown="ModalOverlay_Click">
            <Border Background="{StaticResource Elevated}" CornerRadius="14"
                    BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                    Padding="30,28" MaxWidth="420"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Effect="{StaticResource SoftShadow}"
                    MouseLeftButtonDown="ModalDialog_StopPropagation">
                <StackPanel FlowDirection="RightToLeft">
                    <TextBlock x:Name="ModalTitle" FontSize="15.5" FontWeight="Bold"
                               Foreground="{StaticResource TxtHi}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ModalMessage" FontSize="12.5"
                               Foreground="{StaticResource TxtMid}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,24" LineHeight="20"/>
                    <StackPanel x:Name="ModalButtons" Orientation="Horizontal"
                                HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════ FOOTER ══════════ -->
        <Border x:Name="Footer" Grid.Row="2" Padding="20,8">
            <Grid>
                <TextBlock Foreground="{StaticResource TxtLo}" FontSize="10.5" Opacity="0.7"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Run Text="Virtual LAN Platform"/>
                    <Run Text=" · "/>
                    <Run Text="v1.0.4" FontFamily="Consolas"/>
                </TextBlock>
                <Button Style="{StaticResource Btn.Nav}" HorizontalAlignment="Left"
                        Foreground="{StaticResource TxtLo}" Padding="8,4"
                        Click="CheckUpdate_Click">
                    <StackPanel Orientation="Horizontal">
                        <ico:PackIconLucide Kind="RefreshCw" Width="12" Height="12"
                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="بررسی بروزرسانی" FontSize="10.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
