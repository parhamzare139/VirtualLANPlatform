                            </StackPanel>
                            <WrapPanel>
                                <Button Style="{StaticResource Btn.Ghost}" Height="38" MinHeight="38" Padding="14,0"
                                        FontSize="12.5" Margin="0,0,8,8" Click="WhatsNew_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ico:PackIconLucide Kind="Sparkles" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Tr Settings_WhatsNew}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="SettingsUpdateBtn" Style="{StaticResource Btn.Ghost}" Height="38" MinHeight="38" Padding="14,0"
                                        FontSize="12.5" Margin="0,0,8,8" Click="SettingsCheckUpdate_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ico:PackIconLucide x:Name="SettingsUpdateIcon" Kind="RefreshCw" Width="13" Height="13"
                                                            VerticalAlignment="Center" Margin="0,0,6,0" RenderTransformOrigin="0.5,0.5">
                                            <ico:PackIconLucide.RenderTransform>
                                                <RotateTransform x:Name="SettingsUpdateSpin" Angle="0"/>
                                            </ico:PackIconLucide.RenderTransform>
                                        </ico:PackIconLucide>
                                        <TextBlock Text="{loc:Tr Update_CheckTitle}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Ghost}" Height="38" MinHeight="38" Padding="14,0"
                                        FontSize="12.5" Margin="0,0,8,8" Click="Report_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ico:PackIconLucide Kind="Bug" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Tr Settings_Report}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Btn.Ghost}" Height="38" MinHeight="38" Padding="14,0"
                                        FontSize="12.5" Margin="0,0,8,8" Click="OpenLogs_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <ico:PackIconLucide Kind="FolderOpen" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="{loc:Tr Settings_Logs}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                            <!-- Result of the update check, right here — the user is on this page,
                                 not behind it, so this is where the answer has to land. -->
                            <Border x:Name="SettingsUpdateRow" Background="#141926" CornerRadius="10" Padding="12,9"
                                    Margin="0,2,0,10" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ico:PackIconLucide x:Name="SettingsUpdateStatusIcon" Kind="CircleCheck" Width="15" Height="15"
                                                        Foreground="{StaticResource Ok}" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Grid.Column="1" x:Name="SettingsUpdateStatus" Foreground="{StaticResource TxtMid}"
                                               FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" x:Name="SettingsUpdateNowBtn" Style="{StaticResource Btn.Primary}"
                                            Height="34" MinHeight="34" Padding="14,0" FontSize="12.5" Margin="12,0,0,0"
                                            Visibility="Collapsed" Click="SettingsUpdateNow_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ico:PackIconLucide Kind="Download" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBlock Text="{loc:Tr Update_Now}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <TextBlock Text="{loc:Tr Settings_ReportDesc}" Foreground="{StaticResource TxtLo}"
                                       FontSize="11.5" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                            <TextBlock Text="{loc:Tr Settings_Credits}" Foreground="{StaticResource TxtLo}"
                                       FontSize="10.5" TextWrapping="Wrap" LineHeight="17" Margin="0,10,0,0" Opacity="0.8"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ══════════ SHUTDOWN ══════════ -->
        <!-- Shown while the virtual LAN is taken down on close, so the couple of seconds
             that costs reads as work in progress rather than a frozen window. -->
        <Grid x:Name="ShutdownOverlay" Grid.RowSpan="3" Background="#F20A0C11"
              Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="58" Height="58" CornerRadius="16" Padding="7"
                        Background="#1A1F2E" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           RenderOptions.BitmapScalingMode="Fant"/>
                </Border>
                <TextBlock Text="{loc:Tr Shutdown_Title}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{StaticResource TxtHi}" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:Tr Shutdown_Body}"
                           FontSize="12" Foreground="{StaticResource TxtLo}"
                           HorizontalAlignment="Center" Margin="0,7,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ══════════ MODAL OVERLAY ══════════ -->
        <Grid x:Name="ModalOverlay" Grid.RowSpan="3" Background="#B0000000"
              Visibility="Collapsed" MouseLeftButtonDown="ModalOverlay_Click">
            <Border Background="{StaticResource Elevated}" CornerRadius="14"
                    BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                    Padding="30,28" MaxWidth="420"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MouseLeftButtonDown="ModalDialog_StopPropagation">
                <StackPanel FlowDirection="{Binding Flow, Source={x:Static loc:Loc.I}}">
                    <TextBlock x:Name="ModalTitle" FontSize="15.5" FontWeight="Bold"
                               Foreground="{StaticResource TxtHi}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock x:Name="ModalMessage" FontSize="12.5"
                               Foreground="{StaticResource TxtMid}" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,24" LineHeight="20"/>
                    <StackPanel x:Name="ModalButtons" Orientation="Horizontal"
                                HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════ TOAST OVERLAY ══════════ -->
        <!--
          Bottom corner rather than mid-screen: transient feedback shouldn't land on
          top of whatever the user is reading. The bottom margin clears the composer.
          Under RTL, HorizontalAlignment="Right" is the physical LEFT edge — away from
          the member sidebar. The panel has no background, so only the toasts
          themselves take the mouse; each one is dismissable.
        -->
        <StackPanel x:Name="ToastPanel" Grid.RowSpan="3"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="18,0,18,86" Width="330"/>

        <!-- ══════════ FOOTER ══════════ -->
        <Border x:Name="Footer" Grid.Row="2" Padding="20,8">
            <Grid>
                <TextBlock Foreground="{StaticResource TxtLo}" FontSize="10.5" Opacity="0.7"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Run Text="Virtual LAN Platform"/>
                    <Run Text=" · "/>
                    <Run Text="v1.0.9" FontFamily="Consolas"/>
                </TextBlock>
                <Button Style="{StaticResource Btn.Nav}" HorizontalAlignment="Left"
                        Foreground="{StaticResource TxtLo}" Padding="8,4"
                        Click="CheckUpdate_Click">
                    <StackPanel Orientation="Horizontal">
                        <ico:PackIconLucide Kind="RefreshCw" Width="12" Height="12"
                                            VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="{loc:Tr Update_CheckTitle}" FontSize="10.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
