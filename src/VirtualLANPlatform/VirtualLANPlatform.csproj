<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>VirtualLANPlatform</AssemblyName>
    <RootNamespace>VirtualLANPlatform</RootNamespace>
    <Version>1.0.8.0</Version>
    <AssemblyVersion>1.0.8.0</AssemblyVersion>
    <FileVersion>1.0.8.0</FileVersion>
    <Product>Virtual LAN Platform</Product>
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>12</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
    <PackageReference Include="LiteNetLib" Version="1.1.0" />
    <PackageReference Include="MahApps.Metro.IconPacks.Lucide" Version="6.2.1" />
    <PackageReference Include="Sodium.Core" Version="1.3.4" />
    <PackageReference Include="Concentus" Version="2.2.2" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
  </ItemGroup>

  <!-- wintun.dll — MIT License, WireGuard Project, attribution in About screen -->
  <!-- Copy to root of output so P/Invoke can find it by name -->
  <ItemGroup>
    <None Include="Assets\wintun.dll" CopyToOutputDirectory="Always" TargetPath="wintun.dll" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\logo.ico" />
    <!-- Vazirmatn (SIL OFL) — the maintained successor to Vazir. Bundled so Persian
         text renders correctly on machines that don't have a Persian UI font installed,
         instead of silently falling back to Segoe UI. -->
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- 3D emoji set — curated subset from bignutty/fluent-emoji (MIT), mirroring Microsoft's Fluent Emoji -->
    <Resource Include="Assets\Emoji3D\*.png" />
    <!-- UI sound cues, generated in-house (see scratch gen_sounds.py); tiny 16-bit mono WAVs -->
    <Resource Include="Assets\Sounds\*.wav" />
  </ItemGroup>

</Project>
